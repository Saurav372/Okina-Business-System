---
const {
  title,
  description = 'Okina Craft catalog',
} = Astro.props as {
  title: string;
  description?: string;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f6f4ef;
        --surface: #ffffff;
        --surface-muted: #f2ede4;
        --text: #1f2937;
        --muted: #5f6b7a;
        --line: #d8d2c6;
        --accent: #1f6f8b;
        --shadow: 0 10px 28px rgba(31, 41, 55, 0.08);
        --radius: 8px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      a {
        color: inherit;
      }

      .shell {
        min-height: 100vh;
      }

      .topbar {
        border-bottom: 1px solid var(--line);
        background: rgba(246, 244, 239, 0.96);
        backdrop-filter: blur(8px);
      }

      .topbar-inner,
      .content,
      .footer-inner {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        font-weight: 700;
      }

      .brand-mark {
        display: inline-grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--surface);
        color: var(--accent);
        font-size: 0.9rem;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .nav a {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .nav a:hover,
      .nav a[aria-current="page"] {
        color: var(--text);
      }

      .content {
        padding: 1.5rem 0 3rem;
      }

      .hero,
      .section,
      .panel {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .hero {
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .hero h1,
      .section h2 {
        margin: 0;
        line-height: 1.1;
      }

      .hero p,
      .section p,
      .summary {
        color: var(--muted);
      }

      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        background: var(--surface-muted);
        font-size: 0.88rem;
      }

      .section {
        padding: 1.25rem;
        margin-top: 1rem;
      }

      .section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .grid {
        display: grid;
        gap: 1rem;
      }

      .grid.categories {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .grid.products {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      }

      .card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .card h3,
      .card h4 {
        margin: 0;
        line-height: 1.2;
      }

      .card p {
        margin: 0;
        color: var(--muted);
      }

      .card a {
        text-decoration: none;
      }

      .card-link {
        margin-top: auto;
        color: var(--accent);
        font-weight: 600;
      }

      .detail-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.9fr);
        gap: 1rem;
        align-items: start;
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .table-wrap {
        overflow-x: auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
      }

      th,
      td {
        padding: 0.75rem;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-weight: 600;
        background: var(--surface-muted);
      }

      .footer-inner {
        padding: 1rem 0 2rem;
        color: var(--muted);
        font-size: 0.92rem;
      }

      @media (max-width: 760px) {
        .topbar-inner,
        .section-head,
        .detail-layout {
          display: grid;
          grid-template-columns: 1fr;
        }

        .topbar-inner {
          gap: 0.75rem;
        }

        .nav {
          gap: 0.5rem 1rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="topbar-inner">
          <a class="brand" href="/" aria-label="Okina Craft home">
            <span class="brand-mark">OC</span>
            <span>Okina Craft</span>
          </a>
          <nav class="nav" aria-label="Catalog navigation">
            <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Products</a>
            <a href="/categories" aria-current={Astro.url.pathname === '/categories/' || Astro.url.pathname === '/categories' ? 'page' : undefined}>Categories</a>
          </nav>
        </div>
      </header>
      <main class="content">
        <slot />
      </main>
      <footer class="footer-inner">
        Public catalog data is sourced from the shared backend API and excludes draft or private records.
      </footer>
    </div>
  </body>
</html>
