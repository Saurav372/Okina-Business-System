---
import '../styles/global.css';
import { defaultStorefrontConfig, getStorefrontConfig } from '../lib/catalog';

const {
  title,
  description: providedDescription,
  image,
  noindex = false,
  canonicalUrl,
  robotsIndex = true,
  robotsFollow = true,
  openGraphTitle,
  openGraphDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  structuredData,
} = Astro.props as {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalUrl?: string | null;
  robotsIndex?: boolean;
  robotsFollow?: boolean;
  openGraphTitle?: string | null;
  openGraphDescription?: string | null;
  twitterTitle?: string | null;
  twitterDescription?: string | null;
  twitterImage?: string | null;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
};

let storefrontConfig = defaultStorefrontConfig;
try { storefrontConfig = await getStorefrontConfig(); } catch { /* Keep the storefront usable while settings are unavailable. */ }
const siteName = storefrontConfig.business.company_name || storefrontConfig.seo.site_title || 'Okina Craft';
const description = providedDescription ?? storefrontConfig.seo.meta_description ?? 'Custom apparel, made carefully for teams, events, businesses, and everyday creators.';
const resolvePublicUrl = (value?: string | null): URL | undefined => {
  if (!value) return undefined;
  try {
    const resolved = new URL(value, Astro.site ?? Astro.url.origin);
    return ['http:', 'https:'].includes(resolved.protocol) ? resolved : undefined;
  } catch { return undefined; }
};
let canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
canonical = resolvePublicUrl(canonicalUrl) ?? canonical;
const currentPath = Astro.url.pathname;
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const requestedSocialImage = image ?? storefrontConfig.seo.open_graph_image ?? undefined;
const socialImage = resolvePublicUrl(requestedSocialImage)?.toString();
const twitterSocialImage = resolvePublicUrl(twitterImage)?.toString() ?? socialImage;
const allowIndex = !noindex && robotsIndex && storefrontConfig.seo.robots.index;
const allowFollow = !noindex && robotsFollow && storefrontConfig.seo.robots.follow;
const robotsContent = `${allowIndex ? 'index' : 'noindex'},${allowFollow ? 'follow' : 'nofollow'}`;
const publicApiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL ?? 'http://127.0.0.1:8000/api').replace(/\/+$/, '');
const bulkQuoteUrl = storefrontConfig.business.support_email
  ? `mailto:${storefrontConfig.business.support_email}?subject=${encodeURIComponent('Bulk order quote request')}`
  : '/search?q=bulk';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1816" />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/okina-watermark-mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={openGraphTitle ?? pageTitle} />
    <meta property="og:description" content={openGraphDescription ?? description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={twitterSocialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={twitterTitle ?? openGraphTitle ?? pageTitle} />
    <meta name="twitter:description" content={twitterDescription ?? openGraphDescription ?? description} />
    {twitterSocialImage && <meta name="twitter:image" content={twitterSocialImage} />}
    <title>{pageTitle}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body data-api-base={publicApiBaseUrl} data-tax-inclusive={String(storefrontConfig.business.tax_inclusive_pricing)} data-online-payments={String(storefrontConfig.checkout.online_payments_enabled)}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <aside class="announcement" aria-label="Okina Craft order benefits">
      <span class="sr-only">Proof approved before production. Better pricing for bulk orders. Delivery across India. Customize front, back and sleeves. Your design, your placement, your apparel.</span>
      <span class="announcement__inner" aria-hidden="true">
        <span class="announcement__proof"><span class="announcement__check">✓</span> Proof approved before production</span>
        <span class="announcement__divider"></span>
        <span class="announcement__slider">
          <span class="announcement__message" data-announcement-message>Better pricing for bulk orders</span>
        </span>
      </span>
    </aside>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/" aria-label={`${siteName} home`}>
          <span class="brand-mark" aria-hidden="true"><img class="brand-logo-image" src="/brand/okina-logo.svg" alt="" width="1080" height="1350" fetchpriority="high" /></span>
          <span class="brand-name">{siteName}</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <details class="nav-dropdown" data-nav-dropdown>
            <summary class:list={{ 'is-current': currentPath.startsWith('/products') || currentPath === '/search' }}>
              Products
              <svg class="nav-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="nav-dropdown__panel nav-dropdown__panel--products">
              <div class="nav-dropdown__heading"><strong>Shop by product</strong><span>Choose the garment you want to customize.</span></div>
              <div class="nav-dropdown__grid">
                <a href="/categories/custom-t-shirts">Custom T-Shirts</a><a href="/search?q=polo">Polo T-Shirts</a>
                <a href="/search?q=oversized">Oversized T-Shirts</a><a href="/search?q=shirt">Shirts</a>
                <a href="/search?q=hoodie">Hoodies / Sweatshirts</a><a href="/search?q=jacket">Jackets</a>
                <a href="/search?q=cap">Caps</a><a href="/search">All Products</a>
              </div>
              <a class="nav-dropdown__secondary" href="/mockup-generate">Create your design <span aria-hidden="true">→</span></a>
            </div>
          </details>

          <details class="nav-dropdown" data-nav-dropdown>
            <summary class:list={{ 'is-current': currentPath === '/bulk-orders' }}>
              Bulk &amp; Teams
              <svg class="nav-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="nav-dropdown__panel nav-dropdown__panel--single">
              <div class="nav-dropdown__heading"><strong>Made for groups</strong><span>Find the closest starting point for your order.</span></div>
              <div class="nav-dropdown__list">
                <a href="/search?q=corporate">Corporate Uniforms</a><a href="/search?q=staff">Staff Uniforms</a>
                <a href="/search?q=college">College &amp; Event T-Shirts</a><a href="/search?q=company">Company Merchandise</a>
                <a href="/search?q=bulk+t-shirt">Bulk T-Shirt Printing</a>
              </div>
              <a class="nav-dropdown__cta" href={bulkQuoteUrl}>Request Bulk Quote <span aria-hidden="true">→</span></a>
            </div>
          </details>

          <details class="nav-dropdown" data-nav-dropdown>
            <summary class:list={{ 'is-current': currentPath.startsWith('/categories') }}>
              Collections
              <svg class="nav-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="nav-dropdown__panel nav-dropdown__panel--single">
              <div class="nav-dropdown__heading"><strong>Shop by purpose</strong><span>Start with who the apparel is for.</span></div>
              <div class="nav-dropdown__list">
                <a href="/categories/team-layers">Team Uniforms</a><a href="/categories/event-kits">College Events</a>
                <a href="/categories/workwear">Company Merchandise</a><a href="/search?q=creator">Creator Merch</a>
                <a href="/search?q=gift">Personal Gifts</a><a href="/categories">View All Collections</a>
              </div>
            </div>
          </details>

          <a class="desktop-nav__link" href="/how-it-works" aria-current={currentPath === '/how-it-works' ? 'page' : undefined}>How It Works</a>
        </nav>

        <nav class="utility-nav" aria-label="Store navigation and tools">
          <a class="icon-link" href="/search" aria-label="Search products" title="Search products">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          </a>
          <a class="track-order-link" href="/track-order" aria-current={currentPath === '/track-order' ? 'page' : undefined}>Track Order</a>
          <span class="auth-slot" data-auth-slot><a href="/account">Account</a></span>
          <a class="icon-link" href="/cart" aria-label="Shopping cart" title="Shopping cart">
            <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H7"/><circle cx="10" cy="20" r="1"/><circle cx="19" cy="20" r="1"/></svg>
            <span class="cart-count hidden" id="nav-cart-count" aria-live="polite">0</span>
          </a>
          <details class="mobile-menu" data-mobile-menu>
            <summary aria-label="Navigation menu">
              <svg aria-hidden="true" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <div class="mobile-nav">
              <details class="mobile-nav__group"><summary>Products <span aria-hidden="true">+</span></summary><div><a href="/categories/custom-t-shirts">Custom T-Shirts</a><a href="/search?q=polo">Polo T-Shirts</a><a href="/search?q=oversized">Oversized T-Shirts</a><a href="/search?q=hoodie">Hoodies / Sweatshirts</a><a href="/search">All Products</a></div></details>
              <details class="mobile-nav__group"><summary>Bulk &amp; Teams <span aria-hidden="true">+</span></summary><div><a href="/search?q=corporate">Corporate Uniforms</a><a href="/search?q=staff">Staff Uniforms</a><a href="/search?q=college">College &amp; Event T-Shirts</a><a href="/search?q=company">Company Merchandise</a><a class="mobile-nav__cta" href={bulkQuoteUrl}>Request Bulk Quote</a></div></details>
              <details class="mobile-nav__group"><summary>Collections <span aria-hidden="true">+</span></summary><div><a href="/categories/team-layers">Team Uniforms</a><a href="/categories/event-kits">College Events</a><a href="/categories/workwear">Company Merchandise</a><a href="/search?q=creator">Creator Merch</a><a href="/categories">All Collections</a></div></details>
              <a href="/how-it-works">How It Works</a>
              <a href="/mockup-generate">Create your design</a>
              <a href="/track-order">Track Order</a>
              <span class="mobile-auth-slot" data-auth-slot><a href="/account">Account</a></span>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main class="page-main" id="main-content"><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><img class="brand-logo-image" src="/brand/okina-logo.svg" alt="" width="1080" height="1350" loading="lazy" /></span><span class="brand-name">{siteName}</span></a>
          <p>Custom apparel with a calmer process—from artwork review to careful packing.</p>
        </div>
        <div>
          <p class="footer-title">Shop</p>
          <nav class="footer-links" aria-label="Footer shop links"><a href="/categories">All collections</a><a href="/mockup-generate">Create your design</a><a href="/search">Search products</a><a href="/cart">Your cart</a></nav>
        </div>
        <div>
          <p class="footer-title">Orders</p>
          <nav class="footer-links" aria-label="Footer order links"><a href="/account">My account</a><a href="/track-order">Track an order</a><a href="/how-it-works">Our process</a></nav>
        </div>
        <div>
          <p class="footer-title">Good to know</p>
          <nav class="footer-links" aria-label="Footer information links"><a href="/policies/shipping">Shipping</a><a href="/policies/returns">Returns</a><a href="/policies/privacy">Privacy</a><a href="/policies/terms">Terms</a>{storefrontConfig.business.support_email && <a href={`mailto:${storefrontConfig.business.support_email}`}>Email support</a>}{storefrontConfig.business.support_phone && <a href={`tel:${storefrontConfig.business.support_phone}`}>Call support</a>}</nav>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} {siteName}</span><span>Designed and made in India</span></div>
    </footer>

    <script is:inline>
      const track = (eventName, detail = {}) => {
        const payload = { event: eventName, ...detail };
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(payload);
        document.body.dataset.analyticsEvents = String(window.dataLayer.length);
        window.dispatchEvent(new CustomEvent('okina:analytics', { detail: payload }));
      };
      window.okinaTrack = track;
      track('page_view', { page_path: window.location.pathname, page_title: document.title });
      document.body.dataset.analyticsReady = 'true';
      const productDataElement = document.getElementById('customizer-data');
      if (productDataElement) {
        try {
          const productData = JSON.parse(productDataElement.textContent || '{}');
          track('view_item', { item_id: productData.product?.slug, item_name: productData.product?.name });
        } catch {
          // Page metadata remains optional; product rendering is unaffected.
        }
      }

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element
          ? event.target.closest('[data-analytics-event], [data-place-order]')
          : null;
        if (!target) return;
        const eventName = target.dataset.analyticsEvent || 'begin_checkout';
        track(eventName, { label: target.dataset.analyticsLabel || target.textContent?.trim(), destination: target.getAttribute('href') });
      });

      document.addEventListener('submit', (event) => {
        if (event.target instanceof Element && event.target.matches('[data-customizer-form]')) track('add_to_cart_attempt');
      });

      if (window.location.pathname === '/cart') track('view_cart');

      const trackedOrder = new URLSearchParams(window.location.search).get('order');
      const trackingForm = document.querySelector('[data-tracking-form]');
      const trackingInput = trackingForm?.querySelector('[name="order_id"]');
      if (trackedOrder && trackingForm instanceof HTMLFormElement && trackingInput instanceof HTMLInputElement) {
        trackingInput.value = trackedOrder;
        window.setTimeout(() => trackingForm.requestSubmit(), 0);
      }

      const announcementMessage = document.querySelector('[data-announcement-message]');
      if (announcementMessage) {
        const messages = [
          'Better pricing for bulk orders',
          'Delivery across India',
          'Customize front, back & sleeves',
          'Your design. Your placement. Your apparel.',
        ];
        const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
        let messageIndex = 0;
        let rotationTimer;
        let transitionTimer;

        const stopAnnouncement = () => {
          window.clearInterval(rotationTimer);
          window.clearTimeout(transitionTimer);
          rotationTimer = undefined;
          transitionTimer = undefined;
          announcementMessage.classList.remove('is-leaving', 'is-entering');
        };

        const rotateAnnouncement = () => {
          announcementMessage.classList.add('is-leaving');
          transitionTimer = window.setTimeout(() => {
            messageIndex = (messageIndex + 1) % messages.length;
            announcementMessage.textContent = messages[messageIndex];
            announcementMessage.classList.remove('is-leaving');
            announcementMessage.classList.add('is-entering');
            window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
              announcementMessage.classList.remove('is-entering');
            }));
          }, 300);
        };

        const startAnnouncement = () => {
          stopAnnouncement();
          if (!motionPreference.matches && !document.hidden) {
            rotationTimer = window.setInterval(rotateAnnouncement, 4500);
          }
        };

        motionPreference.addEventListener('change', startAnnouncement);
        document.addEventListener('visibilitychange', startAnnouncement);
        startAnnouncement();
      }

      const apiBaseUrl = (document.body.dataset.apiBase || 'http://127.0.0.1:8000/api').replace(/\/+$/, '');
      const authSlots = document.querySelectorAll('[data-auth-slot]');
      const cartCount = document.getElementById('nav-cart-count');
      const loginUrl = apiBaseUrl.replace(/\/api$/, '/login');

      const escapeAttribute = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);

      Promise.allSettled([
        fetch(`${apiBaseUrl}/customer/session`, { credentials: 'include', headers: { Accept: 'application/json' } }),
        fetch(`${apiBaseUrl}/cart`, { credentials: 'include', headers: { Accept: 'application/json' } }),
      ]).then(async ([sessionResult, cartResult]) => {
        if (authSlots.length && sessionResult.status === 'fulfilled') {
          if (sessionResult.value.ok) {
            const session = await sessionResult.value.json();
            authSlots.forEach((slot) => { slot.innerHTML = session?.authenticated ? '<a href="/account">My account</a>' : `<a href="${escapeAttribute(loginUrl)}">Sign in</a>`; });
          } else authSlots.forEach((slot) => { slot.innerHTML = `<a href="${escapeAttribute(loginUrl)}">Sign in</a>`; });
        }

        if (cartCount && cartResult.status === 'fulfilled' && cartResult.value.ok) {
          const cart = await cartResult.value.json();
          const count = Number(cart?.data?.item_count ?? 0);
          if (count > 0) {
            cartCount.textContent = count > 99 ? '99+' : String(count);
            cartCount.classList.remove('hidden');
          }
        }
      });

      const desktopDropdowns = Array.from(document.querySelectorAll('[data-nav-dropdown]'));
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      desktopDropdowns.forEach((dropdown) => dropdown.addEventListener('toggle', () => {
        if (dropdown.open) desktopDropdowns.forEach((other) => { if (other !== dropdown) other.open = false; });
      }));
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Node)) return;
        if (!desktopDropdowns.some((dropdown) => dropdown.contains(event.target))) desktopDropdowns.forEach((dropdown) => { dropdown.open = false; });
        if (mobileMenu?.open && !mobileMenu.contains(event.target)) mobileMenu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const openDropdown = desktopDropdowns.find((dropdown) => dropdown.open);
        if (openDropdown) {
          openDropdown.open = false;
          openDropdown.querySelector('summary')?.focus();
          return;
        }
        if (mobileMenu?.open) {
          mobileMenu.open = false;
          mobileMenu.querySelector(':scope > summary')?.focus();
        }
      });
    </script>
  </body>
</html>
