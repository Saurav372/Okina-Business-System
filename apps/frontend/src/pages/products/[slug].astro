---
import ProductVisual from '../../components/ProductVisual.astro';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { CatalogRequestError, formatMoney, getCustomizationOptions, getProductPageData, titleCase, type CatalogProduct, type CustomizationOptions } from '../../lib/catalog';
const { slug } = Astro.params;
let product: CatalogProduct | null = null; let options: CustomizationOptions | null = null;
try { [product, options] = await Promise.all([getProductPageData(slug ?? ''), getCustomizationOptions(slug ?? '')]); } catch (error) { if (error instanceof CatalogRequestError && error.status === 404) Astro.response.status = 404; else throw error; }
if (!product || !options) Astro.response.status = 404;
const orderableSkus = product?.skus.filter((sku)=>sku.availability.available_for_checkout)??[];
const initialSku = orderableSkus[0]??product?.skus[0]; const initialPrice = initialSku?.price_minor??product?.base_price_minor??0;
const isCustom = product?.customization_mode !== 'none'; const requiresArtwork = product?.customization_mode === 'required';
const primaryMedia=product?.cover_image??product?.media[0]??null;
const apiBaseUrl=(import.meta.env.PUBLIC_API_BASE_URL??'http://127.0.0.1:8000/api').replace(/\/+$/,'');
const customizerData=product&&options?JSON.stringify({product,options}).replace(/</g,'\\u003c'):'';
const schema=product?[
  {'@context':'https://schema.org','@type':'Product',name:product.name,description:product.seo.description??product.short_description??product.description,image:product.media.map((item)=>item.url),category:product.category?.name,offers:{'@type':'AggregateOffer',priceCurrency:product.currency,lowPrice:(Math.min(...(product.skus.length?product.skus.map((sku)=>sku.price_minor):[product.base_price_minor]))/100).toFixed(2),offerCount:product.skus.length,availability:orderableSkus.length?'https://schema.org/InStock':'https://schema.org/OutOfStock'}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.url.origin).toString()},product.category&&{'@type':'ListItem',position:2,name:product.category.name,item:new URL(`/categories/${product.category.slug}`,Astro.url.origin).toString()},{'@type':'ListItem',position:product.category?3:2,name:product.name,item:Astro.url.toString()}].filter(Boolean)},
]:undefined;
---
<CatalogLayout title={product?.seo.title??product?.name??'Product not found'} description={product?.seo.description??product?.short_description??'This product could not be found.'} image={product?.seo.open_graph.image?.url??product?.cover_image?.url} canonicalUrl={product?.seo.canonical_url} robotsIndex={product?.seo.robots.index} robotsFollow={product?.seo.robots.follow} openGraphTitle={product?.seo.open_graph.title} openGraphDescription={product?.seo.open_graph.description} twitterTitle={product?.seo.twitter.title} twitterDescription={product?.seo.twitter.description} twitterImage={product?.seo.twitter.image?.url} noindex={!product} structuredData={schema}>
{product&&options?<><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{product.category&&<><a href={`/categories/${product.category.slug}`}>{product.category.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{product.name}</span></nav></div>
<section class="container product-layout" data-customizer data-api-base={apiBaseUrl}>
  <div class="product-gallery">{primaryMedia?<ProductVisual name={product.name} image={primaryMedia} priority/>:<div class="product-photo-empty" role="status"><svg aria-hidden="true" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m7 15 3-3 2 2 2-2 3 3"/><circle cx="16.5" cy="9.5" r="1.5"/></svg><strong>Product photos coming soon</strong><span>This gallery will show real product photography only.</span></div>}{product.media.length>1&&<div class="media-thumbnails" aria-label="Product gallery">{product.media.map((item,index)=><button class="media-thumbnail" type="button" data-media-url={item.url} data-media-alt={item.alt_text??product.name} aria-label={`Show image ${index+1} of ${product.media.length}`} aria-pressed={index===0?'true':'false'}><img src={item.url} alt="" loading="lazy" decoding="async"/></button>)}</div>}<div class="gallery-caption"><span>Product photos</span><span>{primaryMedia?'Select a photo to view it larger':'Photos will appear when added to the catalog'}</span></div></div>
  <div class="product-buybox"><div class="cluster"><span class="badge badge--brand">Made to order</span>{orderableSkus.length>0?<span class="badge badge--success">Available</span>:<span class="badge badge--warning">Enquire to order</span>}</div><h1>{product.name}</h1><p class="product-summary">{product.short_description??product.description??'A dependable base for your artwork, team, or brand.'}</p><div class="price-block"><span class="price" data-product-price>{formatMoney(initialPrice,product.currency)}</span>{initialSku?.compare_at_price_minor&&<span class="compare-price">{formatMoney(initialSku.compare_at_price_minor,product.currency)}</span>}<span class="tax-note" data-tax-note>Taxes calculated at checkout</span></div>
    <form class="customizer-form" data-customizer-form novalidate>
      {options.option_groups.map((group)=><fieldset class="option-group" data-option-group={group.code}><legend><span>{group.name}</span>{group.is_required&&<small>Required</small>}</legend><div class="option-values">{group.values.filter((value)=>value.is_active).map((value,index)=><label class="choice"><input type="radio" name={`option-${group.code}`} value={value.code} data-option-code={group.code} data-option-label={value.label} checked={index===0}/><span>{value.label}</span></label>)}</div></fieldset>)}
      {isCustom&&<div class="custom-section"><div class="custom-heading"><div><span class="step-number">01</span><strong>Choose print placement</strong></div><span class="form-help">Review the proof later</span></div><div class="option-values">{options.print_positions.map((position,index)=><label class="choice"><input type="radio" name="print-position" value={position.code} checked={index===0}/><span>{position.label}</span></label>)}</div></div>}
      {isCustom&&<div class="custom-section"><div class="custom-heading"><div><span class="step-number">02</span><strong>Choose print method</strong></div></div><label class="field"><span class="sr-only">Print method</span><select name="print-method">{options.print_methods.map((method)=><option value={method.code}>{method.label}</option>)}</select></label></div>}
      {isCustom&&<div class="custom-section artwork-section"><div class="custom-heading"><div><span class="step-number">03</span><strong>Add your artwork</strong></div>{requiresArtwork&&<small>Required</small>}</div><label class="upload-zone"><input type="file" name="design-file" accept="image/png,image/jpeg,image/webp,image/svg+xml,application/pdf" required={requiresArtwork}/><svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M5 14v5h14v-5"/></svg><span><strong data-file-label>Choose artwork file</strong><small>PNG, JPG, WebP, SVG, or PDF · highest quality works best</small></span></label><label class="field"><span class="field-label">Notes for our artwork team <small>(optional)</small></span><textarea name="customer-note" rows="3" maxlength="1000" placeholder="For example: keep the logo small and centred"></textarea></label></div>}
      <div class="order-controls"><label class="field quantity-field"><span class="field-label">Quantity</span><input type="number" name="quantity" min={product.min_order_quantity} max={product.max_order_quantity??9999} value={product.min_order_quantity}/></label><div class="selected-sku"><span>Selected option</span><strong data-sku-label>{initialSku?.name_suffix??initialSku?.sku_code??'Unavailable'}</strong></div></div><div class="form-status hidden" data-form-status role="alert"></div><button class="button button--brand button--wide add-button" type="submit" disabled={!initialSku?.availability.available_for_checkout}><span data-button-label>{initialSku?.availability.available_for_checkout?'Add customized item to cart':'Currently unavailable'}</span><span aria-hidden="true">→</span></button><p class="approval-note"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg><span><strong>No surprise printing.</strong> Artwork is reviewed before production.</span></p>
    </form>
  </div><script type="application/json" id="customizer-data" set:html={customizerData}></script>
</section>
<section class="product-details section-rule"><div class="container section-space"><div class="details-intro"><p class="eyebrow">Details that matter</p><h2>Built for the idea—and the people wearing it.</h2></div><div class="detail-columns"><article><span class="detail-icon">01</span><h3>Product</h3><p>{product.description??'Comfortable custom apparel prepared to carry your artwork clearly.'}</p><dl><div><dt>Type</dt><dd>{titleCase(product.product_type)}</dd></div><div><dt>Minimum</dt><dd>{product.min_order_quantity} {product.min_order_quantity===1?'piece':'pieces'}</dd></div>{product.max_order_quantity&&<div><dt>Maximum</dt><dd>{product.max_order_quantity} pieces</dd></div>}</dl></article><article><span class="detail-icon">02</span><h3>Customization</h3><p>{isCustom?'Upload your design, pick a placement and method, then keep that exact setup with the order.':'This product is ready to order with its available options.'}</p><dl><div><dt>Mode</dt><dd>{titleCase(product.customization_mode)}</dd></div><div><dt>Fulfilment</dt><dd>{titleCase(product.fulfillment_type)}</dd></div></dl></article><article><span class="detail-icon">03</span><h3>Shipping & support</h3><p>Delivery timing is confirmed from the final order details. Follow production and shipping from your account.</p><a class="text-link" href="/policies/shipping">Read shipping policy →</a></article></div></div></section>
</>:<div class="container section-space"><div class="panel empty-state"><h1>Product not found</h1><p class="muted">This style may have moved or is no longer available.</p><a class="button button--brand" href="/categories">Browse collections</a></div></div>}
<script>
const customizer=document.querySelector('[data-customizer]');if(customizer){const payload=JSON.parse(document.getElementById('customizer-data')?.textContent||'{}');const form=customizer.querySelector('[data-customizer-form]');const priceEl=customizer.querySelector('[data-product-price]');const skuLabel=customizer.querySelector('[data-sku-label]');const statusEl=customizer.querySelector('[data-form-status]');const button=form?.querySelector('button[type="submit"]');const buttonLabel=customizer.querySelector('[data-button-label]');const fileInput=form?.querySelector('input[name="design-file"]');const fileLabel=customizer.querySelector('[data-file-label]');const artworkPreview=customizer.querySelector('[data-artwork-preview]');const apiBase=customizer.dataset.apiBase;const currency=payload.product.currency;const format=(minor)=>new Intl.NumberFormat('en-IN',{style:'currency',currency,maximumFractionDigits:0}).format(Number(minor||0)/100);const selectedOptions=()=>Object.fromEntries(Array.from(form?.querySelectorAll('[data-option-code]:checked')??[]).map(input=>[input.dataset.optionCode,input.value]));const variantKey=()=>{const entries=Object.entries(selectedOptions()).sort(([a],[b])=>a.localeCompare(b));return entries.length?entries.map(([code,value])=>`${code}:${value}`).join('|'):'default'};const currentSku=()=>payload.options.skus.find(sku=>sku.variant_key===variantKey())??null;const setStatus=(message,type='error')=>{if(!statusEl)return;statusEl.textContent=message;statusEl.className=`form-status form-status--${type}`};const clearStatus=()=>statusEl?.classList.add('hidden');const updateMethods=()=>{const position=form?.querySelector('input[name="print-position"]:checked')?.value;const select=form?.querySelector('select[name="print-method"]');if(!position||!select)return;const allowed=payload.options.validation.print_method_compatibility[position]??[];Array.from(select.options).forEach(option=>option.disabled=!allowed.includes(option.value));if(!allowed.includes(select.value))select.value=allowed[0]??''};const updateSelection=()=>{clearStatus();updateMethods();const sku=currentSku();if(priceEl)priceEl.textContent=format(sku?.price_minor??payload.product.base_price_minor);if(skuLabel)skuLabel.textContent=sku?.name_suffix??sku?.sku_code??'Combination unavailable';if(button){button.disabled=!sku?.availability.available_for_checkout;if(buttonLabel)buttonLabel.textContent=sku?.availability.available_for_checkout?'Add customized item to cart':sku?.availability.requires_quote?'Request a quote':'Combination unavailable'}};form?.addEventListener('change',(event)=>{if(event.target?.matches('[data-option-code], input[name="print-position"]'))updateSelection();if(event.target===fileInput){const file=fileInput.files?.[0];if(fileLabel)fileLabel.textContent=file?.name??'Choose artwork file';if(file&&file.type.startsWith('image/')&&artworkPreview){artworkPreview.src=URL.createObjectURL(file);artworkPreview.classList.remove('hidden')}else artworkPreview?.classList.add('hidden')}});form?.addEventListener('submit',async(event)=>{event.preventDefault();clearStatus();const sku=currentSku();if(!sku?.availability.available_for_checkout){setStatus('Choose an available product combination.');return}const quantity=Number(form.querySelector('input[name="quantity"]')?.value||1);const requiresArtwork=payload.product.customization_mode==='required';const designFile=fileInput?.files?.[0];if(requiresArtwork&&!designFile){setStatus('Add your artwork file before continuing.');fileInput?.focus();return}const originalLabel=buttonLabel?.textContent;if(button)button.disabled=true;if(buttonLabel)buttonLabel.textContent=designFile?'Uploading artwork…':'Adding to cart…';try{const selected=selectedOptions();const position=form.querySelector('input[name="print-position"]:checked')?.value??'front';const method=form.querySelector('select[name="print-method"]')?.value??'dtf';const note=form.querySelector('textarea[name="customer-note"]')?.value?.trim()??'';let snapshot={schema_version:1,product:{slug:payload.product.slug,name:payload.product.name},sku_code:sku.sku_code,variant_key:sku.variant_key,selected_options_snapshot:Object.entries(selected).map(([code,value])=>{const group=payload.options.option_groups.find(group=>group.code===code);const option=group?.values.find(item=>item.code===value);return{option_code:code,option_name:group?.name??code,value_code:value,value_label:option?.label??value}}),print_method:method,print_position:position,placement:{x:50,y:50,scale:1,rotation:0},files:[],mockup_preview:null,customer_note:note||null};if(designFile){const upload=new FormData();upload.append('design_file',designFile);upload.append('sku_code',sku.sku_code);Object.entries(selected).forEach(([code,value])=>upload.append(`selected_options[${code}]`,value));upload.append('print_position',position);upload.append('print_method',method);upload.append('customer_note',note);upload.append('placement[x]','50');upload.append('placement[y]','50');upload.append('placement[scale]','1');upload.append('placement[rotation]','0');const uploadResponse=await fetch(`${apiBase}/catalog/products/${encodeURIComponent(payload.product.slug)}/design-upload`,{method:'POST',body:upload,credentials:'include',headers:{Accept:'application/json'}});if(uploadResponse.status===401||uploadResponse.status===403)throw new Error(`SIGN_IN:${apiBase.replace(/\/api$/,'/login')}`);const uploadJson=await uploadResponse.json();if(!uploadResponse.ok)throw new Error(uploadJson?.message??'Artwork could not be uploaded.');snapshot=uploadJson.data.customization_snapshot}if(buttonLabel)buttonLabel.textContent='Saving your item…';const cartResponse=await fetch(`${apiBase}/cart/items`,{method:'POST',credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify({product_slug:payload.product.slug,sku_code:sku.sku_code,quantity,customization_snapshot:snapshot})});const cartJson=await cartResponse.json();if(!cartResponse.ok)throw new Error(cartJson?.message??'The item could not be added.');setStatus('Added to your cart. Your choices and artwork are saved.','success');if(buttonLabel)buttonLabel.textContent='Added to cart ✓';window.setTimeout(()=>window.location.href='/cart',650)}catch(error){const message=String(error?.message??'Something went wrong.');if(message.startsWith('SIGN_IN:')){const login=message.slice(8);setStatus('Sign in before uploading private artwork. Redirecting…');window.setTimeout(()=>window.location.href=login,900)}else{setStatus(message);if(button)button.disabled=false;if(buttonLabel)buttonLabel.textContent=originalLabel??'Add to cart'}}});updateSelection()}
</script>
<script>
const mediaGallery=document.querySelector('.product-gallery');
if(mediaGallery){
  const mainImage=mediaGallery.querySelector('[data-product-media-main]');
  const mediaButtons=Array.from(mediaGallery.querySelectorAll('[data-media-url]'));
  mediaButtons.forEach((button)=>button.addEventListener('click',()=>{
    if(!(mainImage instanceof HTMLImageElement)||!(button instanceof HTMLButtonElement))return;
    mainImage.src=button.dataset.mediaUrl??mainImage.src;
    mainImage.alt=button.dataset.mediaAlt??mainImage.alt;
    mediaButtons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));
  }));
}
const taxNote=document.querySelector('[data-tax-note]');
if(taxNote)taxNote.textContent=document.body.dataset.taxInclusive==='true'?'Inclusive of applicable taxes':'Taxes calculated at checkout';
</script>
</CatalogLayout>
<style>
.product-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(23rem,.85fr);gap:clamp(2rem,5vw,5rem);align-items:start}.product-gallery{position:sticky;top:7rem;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:#e9dfd0}.artwork-preview{position:absolute;z-index:3;top:35%;left:50%;width:18%;height:18%;object-fit:contain;transform:translate(-50%,-50%);filter:drop-shadow(0 3px 4px rgba(0,0,0,.15))}.media-thumbnails{display:flex;gap:.55rem;padding:.7rem;overflow-x:auto;border-top:1px solid var(--color-border);background:var(--color-surface)}.media-thumbnail{flex:0 0 4rem;width:4rem;height:4rem;padding:.2rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-canvas);cursor:pointer}.media-thumbnail[aria-pressed="true"]{border-color:var(--color-brand);box-shadow:0 0 0 2px var(--color-brand-soft)}.media-thumbnail:focus-visible{outline:2px solid var(--color-brand);outline-offset:2px}.media-thumbnail img{width:100%;height:100%;object-fit:cover}.gallery-caption{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-top:1px solid var(--color-border);background:var(--color-surface);color:var(--color-ink-soft);font-size:.7rem;font-weight:700}.product-buybox{padding-bottom:4rem}.product-buybox h1{margin:1.25rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem)}.product-summary{max-width:38rem;color:var(--color-ink-soft);font-size:1.08rem}.price-block{display:flex;flex-wrap:wrap;align-items:baseline;gap:.7rem;padding-block:1.25rem;border-block:1px solid var(--color-border)}.price{font-family:var(--font-display);font-size:2rem;font-weight:700}.compare-price{color:var(--color-ink-faint);text-decoration:line-through}.tax-note{width:100%;color:var(--color-ink-faint);font-size:.74rem}.customizer-form{display:grid;gap:1.5rem;padding-top:1.5rem}.option-group{padding:0;border:0}.option-group legend{display:flex;width:100%;justify-content:space-between;margin-bottom:.75rem;font-weight:800}.option-group small,.custom-heading small{color:var(--color-brand);font-size:.72rem;text-transform:uppercase}.option-values{display:flex;flex-wrap:wrap;gap:.55rem}.choice{cursor:pointer}.choice input{position:absolute;opacity:0;pointer-events:none}.choice span{display:inline-flex;min-width:3rem;min-height:2.6rem;align-items:center;justify-content:center;padding:.55rem .75rem;border:1px solid var(--color-border-strong);border-radius:var(--radius-sm);background:var(--color-surface);font-size:.82rem}.choice input:checked+span{border-color:var(--color-ink);background:var(--color-ink);color:white;box-shadow:var(--focus-ring)}.choice input:focus-visible+span{outline:2px solid var(--color-brand);outline-offset:3px}.custom-section{display:grid;gap:1rem;padding-top:1.4rem;border-top:1px solid var(--color-border)}.custom-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem}.custom-heading>div{display:flex;align-items:center;gap:.7rem}.step-number{display:grid;width:1.7rem;height:1.7rem;place-items:center;border:1px solid var(--color-border-strong);border-radius:50%;color:var(--color-brand);font-size:.65rem;font-weight:800}.upload-zone{display:flex;align-items:center;gap:1rem;padding:1.2rem;border:1px dashed var(--color-border-strong);border-radius:var(--radius-md);background:var(--color-surface);cursor:pointer}.upload-zone:hover{border-color:var(--color-brand);background:var(--color-brand-soft)}.upload-zone input{position:absolute;width:1px;height:1px;opacity:0}.upload-zone span{display:grid}.upload-zone small{color:var(--color-ink-faint);font-size:.75rem}.order-controls{display:grid;grid-template-columns:8rem 1fr;gap:1rem;align-items:end}.selected-sku{display:grid;gap:.2rem;min-height:3rem;align-content:center;padding-left:1rem;border-left:1px solid var(--color-border)}.selected-sku span{color:var(--color-ink-faint);font-size:.7rem;text-transform:uppercase}.form-status{padding:.85rem 1rem;border-radius:var(--radius-sm);font-size:.86rem}.form-status--error{display:block!important;background:var(--color-danger-soft);color:var(--color-danger)}.form-status--success{display:block!important;background:var(--color-success-soft);color:var(--color-success)}.approval-note{display:flex;align-items:flex-start;gap:.65rem;margin:0;color:var(--color-ink-soft);font-size:.78rem}.approval-note svg{flex:0 0 auto;color:var(--color-success)}.product-details{margin-top:var(--space-section);background:var(--color-surface)}.details-intro{display:grid;grid-template-columns:.5fr 1fr;align-items:end;gap:3rem}.details-intro .eyebrow{grid-column:1/-1}.detail-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:3rem;border-block:1px solid var(--color-border)}.detail-columns article{padding:2rem;border-right:1px solid var(--color-border)}.detail-columns article:last-child{border-right:0}.detail-icon{color:var(--color-brand);font-family:var(--font-display)}.detail-columns h3{margin:1.5rem 0 .7rem}.detail-columns p{color:var(--color-ink-soft);font-size:.9rem}.detail-columns dl{display:grid;gap:.6rem;margin:1.5rem 0 0}.detail-columns dl>div{display:flex;justify-content:space-between;gap:1rem;padding-top:.6rem;border-top:1px solid var(--color-border);font-size:.78rem}.detail-columns dt{color:var(--color-ink-faint)}.detail-columns dd{margin:0;font-weight:750}@media(max-width:58rem){.product-layout{grid-template-columns:1fr}.product-gallery{position:relative;top:auto;max-width:42rem}.details-intro{grid-template-columns:1fr}.detail-columns{grid-template-columns:1fr}.detail-columns article{border-right:0;border-bottom:1px solid var(--color-border)}.detail-columns article:last-child{border-bottom:0}}@media(max-width:34rem){.gallery-caption{flex-direction:column}.order-controls{grid-template-columns:1fr}.selected-sku{padding-left:0;border-left:0}}
</style>
<style>
.product-gallery{background:var(--color-surface)}
.product-photo-empty{display:grid;min-height:31rem;place-content:center;justify-items:center;gap:.65rem;padding:2rem;background:var(--color-canvas);color:var(--color-ink-soft);text-align:center}
.product-photo-empty svg{color:var(--color-ink-faint)}
.product-photo-empty strong{color:var(--color-ink);font-family:var(--font-display);font-size:1.2rem}
.product-photo-empty span{max-width:24rem;font-size:.86rem}
@media(max-width:34rem){.product-photo-empty{min-height:25rem}}
</style>
