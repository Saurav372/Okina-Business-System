---
import CategoryCard from '../../components/CategoryCard.astro';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { getCategories, type CatalogCategory } from '../../lib/catalog';
let categories: CatalogCategory[] = []; let available = true;
try { categories = await getCategories(); } catch { available = false; }
---
<CatalogLayout title="Shop Custom Apparel Collections" description="Browse custom apparel collections for teams, events, businesses, creators, and gifts.">
  <div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Collections</span></nav><header class="collection-hero"><p class="eyebrow">Shop by purpose</p><h1>Start with who it’s for.</h1><p class="lede">Choose the closest use case, then shape the garment around your artwork, colours, sizes, and quantity.</p><span class="collection-index" aria-hidden="true">COLLECTIONS / {String(categories.length).padStart(2,'0')}</span></header><section class="section-space" aria-labelledby="collection-heading"><div class="section-head"><h2 id="collection-heading">Every collection</h2><span class="pill">{categories.length} available</span></div>{available && categories.length ? <div class="category-grid">{categories.map((category,index)=><CategoryCard category={category} index={index}/>)}</div> : <div class="panel empty-state"><h3>{available?'New collections are being prepared':'Collections are temporarily unavailable'}</h3><p class="muted">{available?'Please check back soon.':'Refresh this page in a moment to try again.'}</p>{!available&&<button class="button button--ghost" onclick="window.location.reload()">Try again</button>}</div>}</section></div>
</CatalogLayout>
<style>.collection-hero{position:relative;display:grid;grid-template-columns:.9fr 1fr;column-gap:4rem;padding-block:clamp(2rem,7vw,7rem);border-bottom:1px solid var(--color-ink)}.collection-hero .eyebrow{grid-column:1/-1}.collection-hero h1{max-width:9ch;margin-bottom:0}.collection-hero .lede{align-self:end;max-width:34rem}.collection-index{position:absolute;right:0;top:0;color:var(--color-ink-faint);font-size:.65rem;font-weight:850;letter-spacing:.12em}@media(max-width:42rem){.collection-hero{grid-template-columns:1fr;gap:1rem}.collection-index{display:none}}</style>
