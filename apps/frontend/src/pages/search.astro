---
import ProductCard from '../components/ProductCard.astro';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { getProducts, type CatalogProduct } from '../lib/catalog';
let products: CatalogProduct[]=[];let available=true;try{products=await getProducts()}catch{available=false}
---
<CatalogLayout title="Search Products" description="Search Okina Craft custom apparel." noindex><div class="container search-page"><p class="eyebrow">Find a style</p><h1>Search the shop.</h1><label class="search-box"><span class="sr-only">Search products</span><input id="global-product-search" type="search" placeholder="Try “tee”, “hoodie”, or “team”" autofocus/></label><p class="muted" id="search-count" aria-live="polite">{products.length} products available</p>{available?<><div class="product-grid" id="search-results">{products.map((product,index)=><ProductCard product={product} index={index}/>)}</div><div class="panel empty-state hidden" id="search-empty"><h2>No match yet</h2><p class="muted">Try a product type, collection, or a shorter phrase.</p></div></>:<div class="panel empty-state"><h2>Search is temporarily unavailable</h2><p class="muted">Please try again in a moment.</p></div>}</div><script>const input=document.getElementById('global-product-search');const grid=document.getElementById('search-results');const empty=document.getElementById('search-empty');const count=document.getElementById('search-count');const run=()=>{if(!grid)return;const query=String(input?.value??'').trim().toLowerCase();const cards=Array.from(grid.querySelectorAll('[data-product-card]'));let visible=0;cards.forEach(card=>{const show=!query||`${card.dataset.name} ${card.dataset.category}`.includes(query);card.classList.toggle('hidden',!show);if(show)visible+=1});empty?.classList.toggle('hidden',visible>0);if(count)count.textContent=`${visible} ${visible===1?'product':'products'} found`};input?.addEventListener('input',run);const initial=new URLSearchParams(location.search).get('q');if(initial&&input){input.value=initial;run()}</script></CatalogLayout>
<style>.search-page{padding-block:clamp(3rem,8vw,7rem)}.search-page h1{margin-bottom:2rem}.search-box{display:block;max-width:48rem}.search-box input{min-height:4rem!important;font-family:var(--font-display);font-size:clamp(1.25rem,3vw,2rem)!important}.search-page>.muted{margin-block:1rem 2.5rem}</style>
