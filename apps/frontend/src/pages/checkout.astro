---
import CatalogLayout from '../layouts/CatalogLayout.astro';
const apiBaseUrl=(import.meta.env.PUBLIC_API_BASE_URL??'http://127.0.0.1:8000/api').replace(/\/+$/,'');
---
<CatalogLayout title="Secure Checkout" description="Confirm delivery and payment details for your Okina Craft order." noindex>
  <div class="container checkout-page" data-checkout data-api-base={apiBaseUrl}>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/cart">Cart</a><span aria-hidden="true">/</span><span aria-current="page">Checkout</span></nav>
    <header class="checkout-heading"><div><p class="eyebrow">Final review</p><h1>Checkout.</h1></div><ol aria-label="Checkout progress"><li class="is-complete">Cart</li><li class="is-current">Delivery</li><li>Payment</li></ol></header>
    <div class="checkout-loading" data-checkout-loading><div class="spinner" aria-hidden="true"></div><p>Checking your order…</p></div>
    <div class="panel empty-state hidden" data-signin-state><h2>Sign in to continue</h2><p class="muted">Your cart is saved. Sign in so we can securely attach the order, artwork, and delivery details to your account.</p><a class="button button--brand" data-signin-link href="#">Sign in</a><p class="form-help">New here? The sign-in page also has account creation.</p></div>
    <div class="panel empty-state hidden" data-empty-state><h2>Your cart is empty</h2><p class="muted">Add a product before starting checkout.</p><a class="button button--brand" href="/categories">Browse products</a></div>
    <div class="panel empty-state hidden" data-error-state><h2>Checkout needs a moment</h2><p class="muted" data-error-copy>We couldn’t load your details.</p><button class="button button--ghost" type="button" data-retry>Try again</button></div>

    <div class="checkout-layout hidden" data-checkout-layout>
      <main class="checkout-main">
        <section class="checkout-section" aria-labelledby="delivery-title"><div class="checkout-section-head"><span>01</span><div><h2 id="delivery-title">Delivery address</h2><p>Choose where this order should be sent.</p></div></div><div class="address-list" data-shipping-addresses></div><details class="new-address"><summary>+ Add a new address</summary><form class="address-form" data-address-form><div class="form-grid"><label class="field"><span class="field-label">Label</span><input name="label" required placeholder="Home or office"/></label><label class="field"><span class="field-label">Contact name</span><input name="contact_name" required autocomplete="name"/></label><label class="field"><span class="field-label">Phone</span><input name="phone" required autocomplete="tel"/></label><label class="field field--wide"><span class="field-label">Address line 1</span><input name="address_line_1" required autocomplete="address-line1"/></label><label class="field field--wide"><span class="field-label">Address line 2 <small>(optional)</small></span><input name="address_line_2" autocomplete="address-line2"/></label><label class="field"><span class="field-label">City</span><input name="city" required autocomplete="address-level2"/></label><label class="field"><span class="field-label">State</span><input name="state" required autocomplete="address-level1"/></label><label class="field"><span class="field-label">PIN code</span><input name="postal_code" required autocomplete="postal-code" inputmode="numeric"/></label></div><div class="form-status hidden" data-address-status role="alert"></div><button class="button button--ghost" type="submit">Save address</button></form></details></section>
        <section class="checkout-section" aria-labelledby="billing-title"><div class="checkout-section-head"><span>02</span><div><h2 id="billing-title">Billing address</h2><p>Use the delivery address or choose a saved billing address.</p></div></div><label class="check-row"><input type="checkbox" data-same-address checked/><span><strong>Same as delivery address</strong><small>Recommended for personal orders</small></span></label><div class="address-list hidden" data-billing-addresses></div></section>
        <section class="checkout-section" aria-labelledby="payment-title"><div class="checkout-section-head"><span>03</span><div><h2 id="payment-title">Secure payment</h2><p>You’ll continue to the payment provider after validation.</p></div></div><div class="payment-method"><svg aria-hidden="true" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg><span><strong>Online payment</strong><small>UPI, cards, and supported payment methods</small></span><span class="badge badge--success">Secure</span></div><div class="checkout-status hidden" data-checkout-status role="alert"></div></section>
      </main>
      <aside class="review-card" aria-labelledby="review-title"><h2 id="review-title">Order review</h2><div class="review-items" data-review-items></div><dl><div><dt>Subtotal</dt><dd data-review-subtotal>—</dd></div><div><dt>Discount</dt><dd data-review-discount>—</dd></div><div><dt>Shipping</dt><dd data-review-shipping>—</dd></div><div><dt>Tax</dt><dd data-review-tax>—</dd></div><div class="review-total"><dt>Total</dt><dd data-review-total>—</dd></div></dl><button class="button button--brand button--wide" type="button" data-place-order>Validate and continue <span aria-hidden="true">→</span></button><p class="legal-copy">By continuing, you agree to the <a href="/policies/terms">terms</a> and acknowledge the custom-order approval process.</p></aside>
    </div>
  </div>
  <script>
  const root=document.querySelector('[data-checkout]');if(root){const apiBase=root.dataset.apiBase;const loginUrl=apiBase.replace(/\/api$/,'/login');root.querySelector('[data-signin-link]').href=loginUrl;const loading=root.querySelector('[data-checkout-loading]');const signin=root.querySelector('[data-signin-state]');const empty=root.querySelector('[data-empty-state]');const error=root.querySelector('[data-error-state]');const layout=root.querySelector('[data-checkout-layout]');const shippingList=root.querySelector('[data-shipping-addresses]');const billingList=root.querySelector('[data-billing-addresses]');const sameAddress=root.querySelector('[data-same-address]');const orderButton=root.querySelector('[data-place-order]');const checkoutStatus=root.querySelector('[data-checkout-status]');let cart=null;let addresses=[];const escapeHtml=(value)=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));const format=(minor,currency='INR')=>new Intl.NumberFormat('en-IN',{style:'currency',currency,maximumFractionDigits:0}).format(Number(minor||0)/100);const show=(view)=>{loading?.classList.toggle('hidden',view!=='loading');signin?.classList.toggle('hidden',view!=='signin');empty?.classList.toggle('hidden',view!=='empty');error?.classList.toggle('hidden',view!=='error');layout?.classList.toggle('hidden',view!=='checkout')};const addressCard=(address,name,checked)=>`<label class="address-card"><input type="radio" name="${name}" value="${Number(address.id)}" ${checked?'checked':''}/><span><span class="address-title"><strong>${escapeHtml(address.label)}</strong>${address.is_default_shipping||address.is_default_billing?'<small>Default</small>':''}</span><span>${escapeHtml(address.contact_name)} · ${escapeHtml(address.phone)}</span><span>${escapeHtml(address.address_line_1)}${address.address_line_2?`, ${escapeHtml(address.address_line_2)}`:''}</span><span>${escapeHtml(address.city)}, ${escapeHtml(address.state)} ${escapeHtml(address.postal_code)}</span></span></label>`;const renderAddresses=()=>{const shipping=addresses.filter(address=>['shipping','both'].includes(address.address_type));const billing=addresses.filter(address=>['billing','both'].includes(address.address_type));if(shippingList)shippingList.innerHTML=shipping.length?shipping.map((address,index)=>addressCard(address,'shipping_address',address.is_default_shipping||(!shipping.some(row=>row.is_default_shipping)&&index===0))).join(''):'<div class="address-empty">Add a delivery address to continue.</div>';if(billingList)billingList.innerHTML=billing.length?billing.map((address,index)=>addressCard(address,'billing_address',address.is_default_billing||(!billing.some(row=>row.is_default_billing)&&index===0))).join(''):'<div class="address-empty">No billing addresses saved yet.</div>'};const renderCart=()=>{const pricing=cart.pricing??{};root.querySelector('[data-review-items]').innerHTML=(cart.items??[]).map(item=>`<div class="review-item"><span class="review-thumb">${escapeHtml(String(item.product?.name??'O').slice(0,1))}</span><span><strong>${escapeHtml(item.product?.name)}</strong><small>${Number(item.quantity)} × ${format(item.pricing?.unit_price_minor,item.pricing?.currency)}</small></span><strong>${format(item.pricing?.line_total_minor,item.pricing?.currency)}</strong></div>`).join('');root.querySelector('[data-review-subtotal]').textContent=format(pricing.subtotal_amount_minor,pricing.currency);root.querySelector('[data-review-discount]').textContent=pricing.discount_amount_minor?`−${format(pricing.discount_amount_minor,pricing.currency)}`:format(0,pricing.currency);root.querySelector('[data-review-shipping]').textContent=format(pricing.shipping_amount_minor,pricing.currency);root.querySelector('[data-review-tax]').textContent=format(pricing.tax_amount_minor,pricing.currency);root.querySelector('[data-review-total]').textContent=format(pricing.total_amount_minor,pricing.currency)};const load=async()=>{show('loading');try{const sessionResponse=await fetch(`${apiBase}/customer/session`,{credentials:'include',headers:{Accept:'application/json'}});if(sessionResponse.status===401||sessionResponse.status===403){show('signin');return}if(!sessionResponse.ok)throw new Error('We could not verify your account.');const [cartResponse,addressResponse]=await Promise.all([fetch(`${apiBase}/cart`,{credentials:'include',headers:{Accept:'application/json'}}),fetch(`${apiBase}/customer/addresses`,{credentials:'include',headers:{Accept:'application/json'}})]);if(!cartResponse.ok||!addressResponse.ok)throw new Error('We could not load your checkout details.');cart=(await cartResponse.json()).data;addresses=(await addressResponse.json()).data;if(!(cart.items??[]).length){show('empty');return}renderCart();renderAddresses();show('checkout')}catch(exception){root.querySelector('[data-error-copy]').textContent=exception?.message??'We could not load your details.';show('error')}};sameAddress?.addEventListener('change',()=>billingList?.classList.toggle('hidden',sameAddress.checked));root.querySelector('[data-address-form]')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;const status=form.querySelector('[data-address-status]');const button=form.querySelector('button[type="submit"]');button.disabled=true;status.classList.add('hidden');const data=Object.fromEntries(new FormData(form).entries());try{const response=await fetch(`${apiBase}/customer/addresses`,{method:'POST',credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify({...data,address_type:'both',country_code:'IN',is_default_shipping:addresses.length===0,is_default_billing:addresses.length===0})});const json=await response.json();if(!response.ok)throw new Error(json?.message??'The address could not be saved.');addresses.push(json.data);renderAddresses();form.reset();form.closest('details').open=false}catch(exception){status.textContent=exception?.message??'The address could not be saved.';status.className='form-status form-status--error'}finally{button.disabled=false}});orderButton?.addEventListener('click',async()=>{if(document.body.dataset.onlinePayments==='false'){checkoutStatus.textContent='Online checkout is currently paused in dashboard settings. Your cart is safe.';checkoutStatus.className='checkout-status checkout-status--error';return}const shippingId=root.querySelector('input[name="shipping_address"]:checked')?.value;const billingId=sameAddress.checked?shippingId:root.querySelector('input[name="billing_address"]:checked')?.value;if(!shippingId){checkoutStatus.textContent='Choose or add a delivery address.';checkoutStatus.className='checkout-status checkout-status--error';shippingList?.scrollIntoView({behavior:'smooth',block:'center'});return}if(!billingId){checkoutStatus.textContent='Choose a billing address.';checkoutStatus.className='checkout-status checkout-status--error';return}orderButton.disabled=true;const original=orderButton.textContent;orderButton.textContent='Validating your order…';checkoutStatus.classList.add('hidden');try{const addressPayload={shipping_address_id:Number(shippingId),billing_address_id:Number(billingId)};const validationResponse=await fetch(`${apiBase}/cart/checkout/validation`,{method:'POST',credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify(addressPayload)});const validationJson=await validationResponse.json();if(!validationResponse.ok||validationJson?.data?.valid===false){const message=validationJson?.data?.errors?.[0]?.message??validationJson?.data?.errors?.[0]?.code??validationJson?.message??'Review the highlighted checkout details.';throw new Error(message)}orderButton.textContent='Creating secure payment…';const checkoutResponse=await fetch(`${apiBase}/cart/checkout`,{method:'POST',credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify(addressPayload)});const checkoutJson=await checkoutResponse.json();if(!checkoutResponse.ok)throw new Error(checkoutJson?.message??'Checkout could not be completed.');const data=checkoutJson.data;const orderId=data?.pending_order?.public_id;if(data?.payment_attempt?.checkout_url){sessionStorage.setItem('okina_pending_order',orderId??'');window.location.href=data.payment_attempt.checkout_url;return}if(orderId){window.location.href=`/order-confirmation/${encodeURIComponent(orderId)}?state=${encodeURIComponent(data.checkout_state??'pending')}`;return}throw new Error(data?.checkout_message??'The order was saved, but the next step is unavailable.')}catch(exception){checkoutStatus.textContent=exception?.message??'Checkout could not be completed.';checkoutStatus.className='checkout-status checkout-status--error';orderButton.disabled=false;orderButton.textContent=original}});root.querySelector('[data-retry]')?.addEventListener('click',load);load()}
  </script>
</CatalogLayout>
<style>
.checkout-page{padding-bottom:var(--space-section)}.checkout-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-block:2rem 3rem;border-bottom:1px solid var(--color-border)}.checkout-heading h1{margin:0}.checkout-heading ol{display:flex;gap:2.5rem;padding:0;margin:0;list-style:none;counter-reset:steps;color:var(--color-ink-faint);font-size:.72rem;font-weight:800;text-transform:uppercase}.checkout-heading li{position:relative}.checkout-heading li+li::before{position:absolute;top:50%;right:calc(100% + .5rem);width:1.5rem;height:1px;background:var(--color-border-strong);content:""}.checkout-heading .is-complete,.checkout-heading .is-current{color:var(--color-ink)}.checkout-heading .is-current{color:var(--color-brand)}.checkout-loading{display:grid;min-height:25rem;place-items:center;align-content:center;gap:1rem}.checkout-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(21rem,.7fr);gap:clamp(2rem,5vw,4rem);align-items:start;padding-top:3rem}.checkout-main{display:grid;gap:1.2rem}.checkout-section{padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface)}.checkout-section-head{display:flex;gap:1rem;margin-bottom:1.5rem}.checkout-section-head>span{display:grid;flex:0 0 auto;width:2rem;height:2rem;place-items:center;border:1px solid var(--color-ink);border-radius:50%;color:var(--color-brand);font-size:.68rem;font-weight:800}.checkout-section-head h2{margin:0;font-family:var(--font-body);font-size:1.18rem;letter-spacing:0}.checkout-section-head p{margin:.25rem 0 0;color:var(--color-ink-soft);font-size:.82rem}.address-list{display:grid;gap:.7rem}.address-card{position:relative;cursor:pointer}.address-card>input{position:absolute;top:1rem;left:1rem}.address-card>span{display:grid;gap:.2rem;padding:1rem 1rem 1rem 2.8rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-ink-soft);font-size:.78rem}.address-card>input:checked+span{border-color:var(--color-ink);background:#fff;box-shadow:0 0 0 1px var(--color-ink)}.address-title{display:flex;align-items:center;gap:.6rem;color:var(--color-ink)}.address-title small{padding:.16rem .4rem;border-radius:var(--radius-pill);background:var(--color-success-soft);color:var(--color-success);font-size:.62rem}.address-empty{padding:1rem;border:1px dashed var(--color-border-strong);color:var(--color-ink-soft);font-size:.82rem}.new-address{margin-top:1rem}.new-address summary{cursor:pointer;color:var(--color-brand);font-size:.82rem;font-weight:800}.address-form{display:grid;gap:1rem;padding-top:1rem}.form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.field--wide{grid-column:1/-1}.check-row,.payment-method{display:flex;align-items:center;gap:.8rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:#fff}.check-row span,.payment-method span{display:grid}.check-row small,.payment-method small{color:var(--color-ink-faint);font-size:.72rem}.payment-method>.badge{margin-left:auto}.review-card{position:sticky;top:7rem;padding:1.5rem;border:1px solid var(--color-ink);border-radius:var(--radius-md);background:var(--color-surface);box-shadow:var(--shadow-2)}.review-card>h2{font-family:var(--font-body);font-size:1.2rem;letter-spacing:0}.review-items{display:grid;gap:1rem;padding-block:1rem;border-block:1px solid var(--color-border)}.review-item{display:grid;grid-template-columns:2.7rem 1fr auto;gap:.7rem;align-items:center;font-size:.78rem}.review-thumb{display:grid;aspect-ratio:1;place-items:center;background:var(--color-brand);color:white;font-family:var(--font-display)}.review-item>span:nth-child(2){display:grid}.review-item small{color:var(--color-ink-faint)}.review-card dl{display:grid;gap:.8rem;margin-block:1.2rem}.review-card dl>div{display:flex;justify-content:space-between;gap:1rem;color:var(--color-ink-soft);font-size:.82rem}.review-card dd{margin:0;color:var(--color-ink);font-weight:700}.review-card .review-total{padding-top:1rem;border-top:1px solid var(--color-border);color:var(--color-ink);font-size:1.05rem;font-weight:800}.legal-copy{margin:1rem 0 0;color:var(--color-ink-faint);font-size:.7rem;text-align:center}.checkout-status,.form-status{padding:.8rem;margin-top:1rem;border-radius:var(--radius-sm);font-size:.8rem}.checkout-status--error,.form-status--error{display:block!important;background:var(--color-danger-soft);color:var(--color-danger)}@media(max-width:52rem){.checkout-layout{grid-template-columns:1fr}.review-card{position:relative;top:auto}.checkout-heading{align-items:start;flex-direction:column}}@media(max-width:38rem){.checkout-heading ol{gap:1.5rem}.checkout-heading li+li::before{width:.7rem}.form-grid{grid-template-columns:1fr}.field--wide{grid-column:auto}}
</style>
