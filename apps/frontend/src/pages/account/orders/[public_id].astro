---
import CatalogLayout from '../../../layouts/CatalogLayout.astro';

// Since this is a client-side rendered page in a static Astro build,
// we output static paths for compilation and render contents client-side.
export function getStaticPaths() {
  return [
    { params: { public_id: 'placeholder' } }
  ];
}
---

<CatalogLayout title="Order Details - Okina Craft" description="Track your order status, payments, and view custom mockups">
  <div class="back-link-container">
    <a href="/account" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Back to Dashboard
    </a>
  </div>

  <div class="dashboard-container" id="detail-loading">
    <div class="spinner-container">
      <div class="spinner"></div>
      <p>Loading order details...</p>
    </div>
  </div>

  <div class="dashboard-container hidden" id="detail-wrapper">
    <!-- Toast Notification -->
    <div id="toast-banner" class="toast hidden">
      <span id="toast-message">Message text here</span>
      <button id="toast-close" class="toast-close-btn">&times;</button>
    </div>

    <!-- Order Header Panel -->
    <header class="order-detail-header animate-fade-in">
      <div class="header-main">
        <div>
          <span class="order-label">Order Reference</span>
          <h1 id="order-public-id">OD26-000000</h1>
          <p class="order-date">Placed on <span id="order-date-text">-</span></p>
        </div>
        <div class="badge-row">
          <span id="order-status-badge" class="badge">-</span>
          <span id="payment-status-badge" class="badge">-</span>
        </div>
      </div>
      <div class="header-actions">
        <button id="reorder-btn" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          Reorder Items
        </button>
        <a id="support-link" href="#" target="_blank" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Contact Support
        </a>
      </div>
    </header>

    <!-- Visual Tracking Timeline -->
    <div class="card timeline-card animate-slide-in">
      <h2>Tracking Status</h2>
      <div class="timeline" id="tracking-timeline">
        <div class="timeline-step" id="step-placed">
          <div class="step-icon">1</div>
          <div class="step-label">Order Placed</div>
        </div>
        <div class="timeline-step" id="step-confirmed">
          <div class="step-icon">2</div>
          <div class="step-label">Confirmed</div>
        </div>
        <div class="timeline-step" id="step-production">
          <div class="step-icon">3</div>
          <div class="step-label">In Production</div>
        </div>
        <div class="timeline-step" id="step-ready">
          <div class="step-icon">4</div>
          <div class="step-label">Ready to Ship</div>
        </div>
        <div class="timeline-step" id="step-shipped">
          <div class="step-icon">5</div>
          <div class="step-label">Shipped</div>
        </div>
        <div class="timeline-step" id="step-delivered">
          <div class="step-icon">6</div>
          <div class="step-label">Delivered</div>
        </div>
      </div>
      <div id="cancelled-banner" class="cancelled-banner hidden">
        This order has been cancelled.
      </div>
    </div>

    <!-- Main Grid -->
    <div class="detail-layout">
      <!-- Left Column: Items and Transactions -->
      <div class="stack animate-slide-in">
        <!-- Order Items -->
        <div class="card">
          <h2>Items Ordered</h2>
          <div class="items-list" id="items-list">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Payment History -->
        <div class="card">
          <h2>Payments Received</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Method</th>
                  <th>Transaction ID</th>
                  <th>Status</th>
                  <th>Paid Date</th>
                  <th style="text-align: right;">Amount</th>
                </tr>
              </thead>
              <tbody id="payments-list">
                <tr>
                  <td colspan="5" class="empty-state">No payment history recorded.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Refund History -->
        <div class="card hidden" id="refunds-card">
          <h2>Refund History</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Refund ID</th>
                  <th>Refund Type</th>
                  <th>Status</th>
                  <th>Processed Date</th>
                  <th style="text-align: right;">Amount</th>
                </tr>
              </thead>
              <tbody id="refunds-list">
                <tr>
                  <td colspan="5" class="empty-state">No refunds recorded.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Address and Price Snapshot -->
      <div class="stack animate-slide-in">
        <!-- Summary Totals -->
        <div class="card card-summary">
          <h2>Summary</h2>
          <div class="price-summary-row">
            <span>Subtotal</span>
            <span id="price-subtotal">-</span>
          </div>
          <div class="price-summary-row discount">
            <span>Discount</span>
            <span id="price-discount">-</span>
          </div>
          <div class="price-summary-row">
            <span>Shipping</span>
            <span id="price-shipping">-</span>
          </div>
          <div class="price-summary-row">
            <span>Tax</span>
            <span id="price-tax">-</span>
          </div>
          <div class="price-summary-row total">
            <span>Total Amount</span>
            <span id="price-total">-</span>
          </div>
        </div>

        <!-- Shipping and Billing Address -->
        <div class="card">
          <h2>Shipping Address</h2>
          <div class="address-details" id="shipping-address-snapshot">
            <!-- Dynamically populated -->
          </div>
        </div>

        <div class="card">
          <h2>Billing Address</h2>
          <div class="address-details" id="billing-address-snapshot">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Design Notes Panel -->
        <div class="card hidden" id="design-notes-card">
          <h2>Design Review Notes</h2>
          <p id="design-notes-text" class="design-notes-content"></p>
        </div>
      </div>
    </div>
  </div>
</CatalogLayout>

<style>
  /* Detail View Styles */
  .back-link-container {
    max-width: 1040px;
    margin: 1rem auto 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link svg {
    width: 1rem;
    height: 1rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  .dashboard-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .hidden {
    display: none !important;
  }

  /* Spinner & Loading */
  .spinner-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 350px;
    color: var(--muted);
  }

  .spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Order Header panel */
  .order-detail-header {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .header-main {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .order-detail-header h1 {
    margin: 0.25rem 0 0.15rem;
    font-size: 1.8rem;
    font-weight: 800;
  }

  .order-label {
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .order-date {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .badge-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-icon {
    width: 1rem;
    height: 1rem;
    stroke-width: 2.5;
  }

  /* Timeline */
  .timeline-card h2 {
    margin-bottom: 2rem;
  }

  .timeline {
    display: flex;
    justify-content: space-between;
    position: relative;
    padding: 1rem 0;
    margin: 0 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: calc(1rem + 1rem); /* 1rem padding + half of icon height */
    left: 0;
    right: 0;
    height: 3px;
    background: var(--line);
    z-index: 1;
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    flex: 1;
  }

  .step-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface);
    border: 3px solid var(--line);
    color: var(--muted);
    font-weight: 700;
    font-size: 0.9rem;
    display: grid;
    place-items: center;
    transition: all 0.3s;
  }

  .step-label {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
    transition: color 0.3s;
  }

  /* Active/Completed states */
  .timeline-step.completed .step-icon {
    background: var(--success-color);
    border-color: var(--success-color);
    color: #fff;
  }

  .timeline-step.completed .step-label {
    color: var(--text);
  }

  .timeline-step.active .step-icon {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 5px rgba(31, 111, 139, 0.15);
  }

  .timeline-step.active .step-label {
    color: var(--accent);
    font-weight: 700;
  }

  .cancelled-banner {
    background: rgba(244, 67, 54, 0.1);
    border: 1px dashed var(--danger-color);
    color: var(--danger-color);
    border-radius: var(--radius);
    padding: 1rem;
    text-align: center;
    font-weight: 700;
    font-size: 1rem;
  }

  /* Layout grids */
  .detail-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .stack {
    display: grid;
    gap: 1.5rem;
  }

  /* Cards styling */
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .card h2 {
    margin: 0 0 1.25rem;
    font-size: 1.3rem;
    font-weight: 750;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
  }

  .card-summary {
    background: var(--surface-muted);
  }

  /* Order Item rows */
  .items-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .item-row {
    display: flex;
    gap: 1.25rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.5rem;
  }

  .item-row:last-child {
    border: none;
    padding-bottom: 0;
  }

  .item-mockup {
    width: 90px;
    height: 90px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: #fff;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-mockup img,
  .item-mockup iframe {
    width: 100%;
    height: 100%;
    border: none;
    object-fit: contain;
  }

  .item-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .item-info-top h4 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .item-sku {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 550;
  }

  .item-customization-summary {
    margin-top: 0.5rem;
    background: var(--surface-muted);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.82rem;
    border: 1px solid var(--line);
  }

  .item-customization-summary p {
    margin: 0.15rem 0;
    color: var(--text);
  }

  .item-preview-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.35rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .item-preview-link:hover {
    text-decoration: underline;
  }

  .item-info-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0.75rem;
  }

  .item-quantity {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .item-total {
    font-weight: 700;
    font-size: 1.05rem;
  }

  /* Price summary row */
  .price-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .price-summary-row.discount {
    color: var(--danger-color);
  }

  .price-summary-row.total {
    border-top: 2px solid var(--line);
    padding-top: 1rem;
    margin-top: 1rem;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .address-details {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .address-details p {
    margin: 0.25rem 0;
  }

  .design-notes-content {
    background: #fff8e1;
    border-left: 4px solid #ffb300;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    line-height: 1.4;
    border-radius: 0 6px 6px 0;
    margin: 0;
  }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-unpaid { background: #ffebee; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }
  .badge-paid { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .badge-partially_paid { background: #fff8e1; color: #f57f17; border: 1px solid rgba(245,127,23,0.2); }
  .badge-refunded { background: #eceff1; color: #37474f; border: 1px solid rgba(55,71,79,0.2); }
  .badge-partially_refunded { background: #eceff1; color: #37474f; border: 1px solid rgba(55,71,79,0.2); }

  .badge-pending { background: #fff3e0; color: #ef6c00; }
  .badge-confirmed { background: #e3f2fd; color: #1565c0; }
  .badge-in_production { background: #ede7f6; color: #651fff; }
  .badge-ready_to_ship { background: #f1f8e9; color: #558b2f; }
  .badge-shipped { background: #e0f7fa; color: #00838f; }
  .badge-delivered { background: #e8f5e9; color: #2e7d32; }
  .badge-cancelled { background: #ffebee; color: #c62828; }

  /* Toast Notification */
  .toast {
    position: fixed;
    top: 2rem;
    right: 2rem;
    background: var(--text);
    color: var(--surface);
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    z-index: 1000;
    font-weight: 500;
    font-size: 0.95rem;
    animation: slideIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  }

  @keyframes slideIn {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .toast-close-btn {
    background: none;
    border: none;
    color: inherit;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  /* Table styling */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th {
    background: var(--surface-muted);
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    padding: 0.65rem 0.75rem;
  }

  td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .empty-state {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
    font-weight: 500;
  }

  .capitalize {
    text-transform: capitalize;
  }

  /* Animations */
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out;
  }

  .animate-slide-in {
    animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { transform: translateY(15px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 820px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }
    .timeline {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .timeline::before {
      display: none;
    }
    .order-detail-header {
      padding: 1.25rem;
    }
    .header-actions {
      width: 100%;
    }
    .header-actions .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  const apiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL ?? 'http://127.0.0.1:8000/api').replace(/\/+$/, '');
  const loginUrl = apiBaseUrl.replace('/api', '/login');

  let orderData: any = null;

  // Extract public ID from path
  const pathParts = window.location.pathname.split('/');
  const publicId = pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];

  // DOM Elements
  const loadingEl = document.getElementById('detail-loading');
  const wrapperEl = document.getElementById('detail-wrapper');
  
  // Header Elements
  const orderIdEl = document.getElementById('order-public-id');
  const orderDateEl = document.getElementById('order-date-text');
  const orderBadge = document.getElementById('order-status-badge');
  const paymentBadge = document.getElementById('payment-status-badge');

  // Address
  const shippingAddressEl = document.getElementById('shipping-address-snapshot');
  const billingAddressEl = document.getElementById('billing-address-snapshot');

  // Pricing
  const priceSubtotal = document.getElementById('price-subtotal');
  const priceDiscount = document.getElementById('price-discount');
  const priceShipping = document.getElementById('price-shipping');
  const priceTax = document.getElementById('price-tax');
  const priceTotal = document.getElementById('price-total');

  // Items
  const itemsList = document.getElementById('items-list');

  // Ledgers
  const paymentsList = document.getElementById('payments-list');
  const refundsCard = document.getElementById('refunds-card');
  const refundsList = document.getElementById('refunds-list');

  // Design Notes
  const designNotesCard = document.getElementById('design-notes-card');
  const designNotesText = document.getElementById('design-notes-text');

  // Actions
  const reorderBtn = document.getElementById('reorder-btn');
  const supportLink = document.getElementById('support-link') as HTMLAnchorElement;

  // Toast
  const toastBanner = document.getElementById('toast-banner');
  const toastMessage = document.getElementById('toast-message');
  const toastClose = document.getElementById('toast-close');

  async function init() {
    if (!publicId || publicId === 'placeholder') {
      window.location.href = '/account';
      return;
    }

    try {
      // 1. Authenticate check
      const sessionRes = await fetch(`${apiBaseUrl}/customer/session`, { credentials: 'include' });
      if (sessionRes.status === 401) {
        window.location.href = loginUrl;
        return;
      }
      
      // 2. Fetch order details
      const detailRes = await fetch(`${apiBaseUrl}/customer/orders/${publicId}`, { credentials: 'include' });
      if (!detailRes.ok) {
        window.location.href = '/account';
        return;
      }

      const json = await detailRes.json();
      orderData = json.data;

      // 3. Render layout
      renderOrderHeader();
      renderTimeline();
      renderPricingSummary();
      renderAddresses();
      renderItems();
      renderPayments();
      renderRefunds();
      renderDesignNotes();
      setupActions();

      // Bind toast
      toastClose?.addEventListener('click', () => toastBanner?.classList.add('hidden'));

      // Show wrapper
      loadingEl?.classList.add('hidden');
      wrapperEl?.classList.remove('hidden');

    } catch (e) {
      console.error(e);
      window.location.href = '/account';
    }
  }

  function renderOrderHeader() {
    if (orderIdEl) orderIdEl.textContent = orderData.public_id;
    if (orderDateEl && orderData.placed_at) {
      orderDateEl.textContent = new Intl.DateTimeFormat('en-IN', {
        dateStyle: 'medium',
        timeStyle: 'short'
      }).format(new Date(orderData.placed_at));
    }

    if (orderBadge) {
      orderBadge.textContent = titleCase(orderData.status);
      orderBadge.className = `badge badge-${orderData.status}`;
    }

    if (paymentBadge) {
      paymentBadge.textContent = titleCase(orderData.payment_status);
      paymentBadge.className = `badge badge-${orderData.payment_status}`;
    }
  }

  function renderTimeline() {
    const status = orderData.status;

    // Reset all step classes
    const steps = ['placed', 'confirmed', 'production', 'ready', 'shipped', 'delivered'];
    steps.forEach(step => {
      const el = document.getElementById(`step-${step}`);
      el?.classList.remove('active', 'completed');
    });

    const banner = document.getElementById('cancelled-banner');
    const timeline = document.getElementById('tracking-timeline');

    if (status === 'cancelled') {
      banner?.classList.remove('hidden');
      timeline?.classList.add('hidden');
      return;
    }

    banner?.classList.add('hidden');
    timeline?.classList.remove('hidden');

    // Define step active mapping
    const orderStatusMapping: Record<string, string> = {
      'pending_payment': 'placed',
      'confirmed': 'confirmed',
      'in_production': 'production',
      'ready_to_ship': 'ready',
      'shipped': 'shipped',
      'delivered': 'delivered',
      'refunded': 'delivered' // show as completed
    };

    const currentStep = orderStatusMapping[status] || 'placed';
    const currentIndex = steps.indexOf(currentStep);

    steps.forEach((step, i) => {
      const el = document.getElementById(`step-${step}`);
      if (i < currentIndex) {
        el?.classList.add('completed');
      } else if (i === currentIndex) {
        el?.classList.add('active');
      }
    });
  }

  function renderPricingSummary() {
    const format = (minor: number) => new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: orderData.currency ?? 'INR',
      maximumFractionDigits: 0
    }).format(minor / 100);

    if (priceSubtotal) priceSubtotal.textContent = format(orderData.subtotal_amount_minor);
    if (priceDiscount) {
      const discount = orderData.discount_amount_minor;
      priceDiscount.textContent = discount > 0 ? `-${format(discount)}` : format(0);
    }
    if (priceShipping) priceShipping.textContent = format(orderData.shipping_amount_minor);
    if (priceTax) priceTax.textContent = format(orderData.tax_amount_minor);
    if (priceTotal) priceTotal.textContent = format(orderData.total_amount_minor);
  }

  function renderAddresses() {
    const render = (snapshot: any) => {
      if (!snapshot) return '<p class="empty-state">Address snapshot not stored.</p>';
      return `
        <p><strong>${escapeHtml(snapshot.contact_name)}</strong></p>
        <p>${escapeHtml(snapshot.phone)}</p>
        ${snapshot.company_name ? `<p>${escapeHtml(snapshot.company_name)}</p>` : ''}
        ${snapshot.gstin ? `<p>GST: ${escapeHtml(snapshot.gstin)}</p>` : ''}
        <p>${escapeHtml(snapshot.address_line_1)}</p>
        ${snapshot.address_line_2 ? `<p>${escapeHtml(snapshot.address_line_2)}</p>` : ''}
        ${snapshot.landmark ? `<p>Landmark: ${escapeHtml(snapshot.landmark)}</p>` : ''}
        <p>${escapeHtml(snapshot.city)}, ${escapeHtml(snapshot.state)} - ${escapeHtml(snapshot.postal_code)}</p>
        <p>${escapeHtml(snapshot.country_code)}</p>
      `;
    };

    if (shippingAddressEl) shippingAddressEl.innerHTML = render(orderData.shipping_address_snapshot);
    if (billingAddressEl) billingAddressEl.innerHTML = render(orderData.billing_address_snapshot);
  }

  function renderItems() {
    if (!itemsList) return;

    itemsList.innerHTML = orderData.items.map((item: any) => {
      const formattedPrice = new Intl.NumberFormat('en-IN', { style: 'currency', currency: orderData.currency ?? 'INR' }).format(item.unit_price_minor / 100);
      const formattedTotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: orderData.currency ?? 'INR', maximumFractionDigits: 0 }).format(item.line_total_minor / 100);
      
      const custom = item.customization_snapshot;
      let customizationHtml = '';
      let mockupHtml = '<div class="item-mockup"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:2rem;height:2rem;color:var(--line);"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';

      if (custom) {
        let optionsList = '';
        if (custom.selected_options_snapshot) {
          optionsList = Object.values(custom.selected_options_snapshot as Record<string, any>)
            .map((opt: any) => `<p><strong>${escapeHtml(opt.option_name)}:</strong> ${escapeHtml(opt.value_label)}</p>`)
            .join('');
        }

        customizationHtml = `
          <div class="item-customization-summary">
            ${optionsList}
            ${custom.print_position ? `<p><strong>Print Position:</strong> ${escapeHtml(custom.print_position)}</p>` : ''}
            ${custom.print_method ? `<p><strong>Print Method:</strong> ${escapeHtml(custom.print_method)}</p>` : ''}
            ${custom.notes ? `<p><strong>Notes:</strong> <em>${escapeHtml(custom.notes)}</em></p>` : ''}
          </div>
        `;

        if (custom.mockup_preview_url) {
          mockupHtml = `
            <div class="item-mockup">
              <iframe src="${custom.mockup_preview_url}" scrolling="no"></iframe>
            </div>
          `;
        }
      }

      return `
        <div class="item-row">
          ${mockupHtml}
          <div class="item-info">
            <div class="item-info-top">
              <h4>${escapeHtml(item.product_name)}</h4>
              <span class="item-sku">SKU: ${escapeHtml(item.sku_code)}</span>
              ${customizationHtml}
            </div>
            <div class="item-info-bottom">
              <span class="item-quantity">${item.quantity} &times; ${formattedPrice}</span>
              <span class="item-total">${formattedTotal}</span>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function renderPayments() {
    if (!paymentsList) return;

    const payments = orderData.payments || [];
    if (payments.length === 0) {
      paymentsList.innerHTML = `<tr><td colspan="5" class="empty-state">No payment records found.</td></tr>`;
      return;
    }

    paymentsList.innerHTML = payments.map((pay: any) => {
      const paidDate = pay.paid_at ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(new Date(pay.paid_at)) : '-';
      const formattedAmount = new Intl.NumberFormat('en-IN', { style: 'currency', currency: pay.currency ?? 'INR', maximumFractionDigits: 0 }).format(pay.amount_minor / 100);

      return `
        <tr>
          <td><span class="capitalize">${escapeHtml(pay.provider)} (${escapeHtml(pay.payment_type)})</span></td>
          <td><code>${escapeHtml(pay.provider_payment_id || pay.receipt_number || '-')}</code></td>
          <td><span class="badge badge-${pay.status}">${pay.status}</span></td>
          <td>${paidDate}</td>
          <td style="text-align: right; font-weight: 700;">${formattedAmount}</td>
        </tr>
      `;
    }).join('');
  }

  function renderRefunds() {
    const refunds = orderData.refunds || [];
    if (refunds.length === 0) {
      refundsCard?.classList.add('hidden');
      return;
    }

    refundsCard?.classList.remove('hidden');
    if (!refundsList) return;

    refundsList.innerHTML = refunds.map((ref: any) => {
      const processedDate = ref.processed_at ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(new Date(ref.processed_at)) : '-';
      const formattedAmount = new Intl.NumberFormat('en-IN', { style: 'currency', currency: ref.currency ?? 'INR', maximumFractionDigits: 0 }).format(ref.amount_minor / 100);

      return `
        <tr>
          <td><code>${escapeHtml(ref.provider_refund_id || '-')}</code></td>
          <td><span class="capitalize">${escapeHtml(ref.refund_type)} Refund</span></td>
          <td><span class="badge badge-${ref.status}">${ref.status}</span></td>
          <td>${processedDate}</td>
          <td style="text-align: right; font-weight: 700; color: var(--danger-color);">${formattedAmount}</td>
        </tr>
      `;
    }).join('');
  }

  function renderDesignNotes() {
    const notes = orderData.design_notes;
    if (notes && notes.trim() !== '') {
      if (designNotesCard) designNotesCard.classList.remove('hidden');
      if (designNotesText) designNotesText.textContent = notes;
    } else {
      designNotesCard?.classList.add('hidden');
    }
  }

  function setupActions() {
    // Reorder Action
    reorderBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      reorderBtn.setAttribute('disabled', 'true');
      reorderBtn.innerHTML = '<span class="spinner" style="width:0.8rem;height:0.8rem;margin:0;border-width:2px;display:inline-block;vertical-align:middle;"></span> Reordering...';

      try {
        const res = await fetch(`${apiBaseUrl}/customer/orders/${publicId}/reorder`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Accept': 'application/json' }
        });

        const data = await res.json();

        if (res.ok) {
          showToast(data.message || 'Items added to cart.');
          // Redirect to cart route on frontend
          setTimeout(() => {
            window.location.href = '/cart';
          }, 1500);
        } else {
          showToast(data.message || 'Failed to reorder items.', true);
          reorderBtn.removeAttribute('disabled');
          reorderBtn.innerHTML = 'Reorder Items';
        }
      } catch (e) {
        showToast('Connection error occurred.', true);
        reorderBtn.removeAttribute('disabled');
        reorderBtn.innerHTML = 'Reorder Items';
      }
    });

    // Support WhatsApp link
    if (supportLink) {
      const message = encodeURIComponent(`Hi, I need support with my order ${orderData.public_id}.`);
      supportLink.href = `https://wa.me/919999999999?text=${message}`; // Configure target phone number later
    }
  }

  // Toast Banner
  function showToast(message: string, isError = false) {
    if (!toastBanner || !toastMessage) return;
    toastMessage.textContent = message;
    if (isError) {
      toastBanner.style.background = 'var(--danger-color)';
    } else {
      toastBanner.style.background = 'var(--text)';
    }
    toastBanner.classList.remove('hidden');

    setTimeout(() => {
      toastBanner.classList.add('hidden');
    }, 5000);
  }

  function titleCase(value: string) {
    if (!value) return '';
    return value
      .split(/[-_]/g)
      .map(part => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ');
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  document.addEventListener('DOMContentLoaded', init);
</script>
