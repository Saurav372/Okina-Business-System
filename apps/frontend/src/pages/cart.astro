---
import CatalogLayout from '../layouts/CatalogLayout.astro';
const apiBaseUrl=(import.meta.env.PUBLIC_API_BASE_URL??'http://127.0.0.1:8000/api').replace(/\/+$/,'');
---
<CatalogLayout title="Your Cart" description="Review your Okina Craft custom products before checkout." noindex>
  <div class="container cart-page" data-cart-page data-api-base={apiBaseUrl}>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Cart</span></nav>
    <header class="cart-heading"><div><p class="eyebrow">Review your choices</p><h1>Your cart.</h1></div><p class="lede">Artwork, placement, product options, and quantities stay attached to every item.</p></header>

    <div class="loading-state" data-cart-loading><div class="spinner" aria-hidden="true"></div><p>Preparing your cart…</p></div>
    <div class="panel empty-state hidden" data-cart-error><h2>We couldn’t load your cart</h2><p class="muted">Your items are still safe. Try again in a moment.</p><button class="button button--ghost" type="button" data-cart-retry>Try again</button></div>
    <div class="panel empty-state hidden" data-cart-empty><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H7"/><circle cx="10" cy="20" r="1"/><circle cx="19" cy="20" r="1"/></svg><h2>Your cart is ready for an idea</h2><p class="muted">Choose a style, add your artwork, and it will appear here.</p><a class="button button--brand" href="/categories">Start customizing</a></div>

    <div class="cart-layout hidden" data-cart-layout>
      <section aria-labelledby="cart-items-title"><div class="cart-list-head"><h2 id="cart-items-title">Items <span data-item-count></span></h2><a class="text-link" href="/categories">Continue shopping</a></div><div class="cart-items" data-cart-items></div><div class="cart-validation hidden" data-cart-validation role="status"></div></section>
      <aside class="summary-card" aria-labelledby="summary-title"><p class="eyebrow">Final review comes next</p><h2 id="summary-title">Order summary</h2><dl><div><dt>Subtotal</dt><dd data-subtotal>—</dd></div><div><dt>Discount</dt><dd data-discount>—</dd></div><div><dt>Shipping</dt><dd data-shipping>Calculated at checkout</dd></div><div><dt>Tax</dt><dd data-tax>—</dd></div><div class="summary-total"><dt>Total</dt><dd data-total>—</dd></div></dl><a class="button button--brand button--wide" href="/checkout" data-checkout-link>Continue to checkout <span aria-hidden="true">→</span></a><div class="summary-trust"><span>✓ Artwork saved securely</span><span>✓ Address checked before payment</span><span>✓ Approval before production</span></div></aside>
    </div>
  </div>
  <script>
    const root=document.querySelector('[data-cart-page]');if(root){const apiBase=root.dataset.apiBase;const loading=root.querySelector('[data-cart-loading]');const error=root.querySelector('[data-cart-error]');const empty=root.querySelector('[data-cart-empty]');const layout=root.querySelector('[data-cart-layout]');const itemsEl=root.querySelector('[data-cart-items]');const countEl=root.querySelector('[data-item-count]');const validationEl=root.querySelector('[data-cart-validation]');const escapeHtml=(value)=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));const format=(minor,currency='INR')=>new Intl.NumberFormat('en-IN',{style:'currency',currency,maximumFractionDigits:0}).format(Number(minor||0)/100);let cart=null;const setView=(view)=>{loading?.classList.toggle('hidden',view!=='loading');error?.classList.toggle('hidden',view!=='error');empty?.classList.toggle('hidden',view!=='empty');layout?.classList.toggle('hidden',view!=='cart')};const customization=(item)=>{const snapshot=item.customization??{};const selections=Array.isArray(snapshot.selected_options_snapshot)?snapshot.selected_options_snapshot.map(option=>escapeHtml(`${option.option_name??option.option_code}: ${option.value_label??option.value_code}`)).join(' · '):'';const print=snapshot.print_position?`${String(snapshot.print_position).replaceAll('_',' ')} · ${String(snapshot.print_method??'').replaceAll('_',' ')}`:'';return [selections,print].filter(Boolean).map(line=>`<span>${line}</span>`).join('')};const render=()=>{const items=cart?.items??[];if(!items.length){setView('empty');return}setView('cart');if(countEl)countEl.textContent=`(${cart.item_count})`;if(itemsEl)itemsEl.innerHTML=items.map((item,index)=>`<article class="cart-item" data-cart-item="${escapeHtml(item.id)}"><a class="item-visual" href="/products/${encodeURIComponent(item.product?.slug??'')}"><span>${escapeHtml(String(item.product?.name??'O').slice(0,2).toUpperCase())}</span></a><div class="item-main"><div><p class="item-kicker">Customized item ${index+1}</p><h3><a href="/products/${encodeURIComponent(item.product?.slug??'')}">${escapeHtml(item.product?.name)}</a></h3><div class="item-options">${customization(item)}</div></div><div class="item-controls"><label><span>Quantity</span><input class="quantity-input" type="number" min="1" max="9999" value="${Number(item.quantity)}" data-quantity></label><button class="remove-button" type="button" data-remove>Remove</button></div></div><div class="item-price"><strong>${format(item.pricing?.line_total_minor,item.pricing?.currency)}</strong><span>${format(item.pricing?.unit_price_minor,item.pricing?.currency)} each</span></div></article>`).join('');const pricing=cart.pricing??{};root.querySelector('[data-subtotal]').textContent=format(pricing.subtotal_amount_minor,pricing.currency);root.querySelector('[data-discount]').textContent=pricing.discount_amount_minor?`−${format(pricing.discount_amount_minor,pricing.currency)}`:format(0,pricing.currency);root.querySelector('[data-tax]').textContent=format(pricing.tax_amount_minor,pricing.currency);root.querySelector('[data-total]').textContent=format(pricing.total_amount_minor,pricing.currency)};const load=async()=>{setView('loading');try{const [cartResponse,validationResponse]=await Promise.all([fetch(`${apiBase}/cart`,{credentials:'include',headers:{Accept:'application/json'}}),fetch(`${apiBase}/cart/validation`,{credentials:'include',headers:{Accept:'application/json'}})]);if(!cartResponse.ok)throw new Error();cart=(await cartResponse.json()).data;render();if(validationResponse.ok){const validation=(await validationResponse.json()).data;const errors=validation?.errors??[];if(errors.length&&validationEl){validationEl.innerHTML=`<strong>One detail needs attention before checkout.</strong><span>${escapeHtml(errors[0].message??errors[0].code??'Please review your cart.')}</span>`;validationEl.classList.remove('hidden')}}}catch{setView('error')}};itemsEl?.addEventListener('change',async(event)=>{const input=event.target.closest('[data-quantity]');if(!input)return;const item=input.closest('[data-cart-item]');const quantity=Math.max(1,Math.min(9999,Number(input.value||1)));input.disabled=true;try{const response=await fetch(`${apiBase}/cart/items/${encodeURIComponent(item.dataset.cartItem)}`,{method:'PATCH',credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json'},body:JSON.stringify({quantity})});if(!response.ok)throw new Error();cart=(await response.json()).data;render()}catch{input.disabled=false;input.value=String(cart.items.find(row=>row.id===item.dataset.cartItem)?.quantity??1);alert('The quantity could not be updated. Please try again.')}});itemsEl?.addEventListener('click',async(event)=>{const trigger=event.target.closest('[data-remove]');if(!trigger)return;const item=trigger.closest('[data-cart-item]');trigger.disabled=true;try{const response=await fetch(`${apiBase}/cart/items/${encodeURIComponent(item.dataset.cartItem)}`,{method:'DELETE',credentials:'include',headers:{Accept:'application/json'}});if(!response.ok)throw new Error();cart=(await response.json()).data;render()}catch{trigger.disabled=false;alert('The item could not be removed. Please try again.')}});root.querySelector('[data-cart-retry]')?.addEventListener('click',load);load()}
  </script>
</CatalogLayout>
<style>
.cart-page{padding-bottom:var(--space-section)}.cart-heading{display:grid;grid-template-columns:.75fr 1fr;gap:4rem;align-items:end;padding-block:2rem 4rem;border-bottom:1px solid var(--color-border)}.cart-heading h1{margin:0}.loading-state{display:grid;min-height:24rem;place-items:center;align-content:center;gap:1rem;color:var(--color-ink-soft)}.cart-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(20rem,.7fr);gap:clamp(2rem,5vw,4rem);align-items:start;padding-top:3rem}.cart-list-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.cart-list-head h2{margin:0;font-family:var(--font-body);font-size:1.25rem;letter-spacing:0}.cart-items{border-top:1px solid var(--color-border)}.cart-item{display:grid;grid-template-columns:8rem 1fr auto;gap:1.2rem;padding-block:1.5rem;border-bottom:1px solid var(--color-border)}.item-visual{display:grid;min-height:9rem;place-items:center;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:linear-gradient(145deg,#d92d2d,#7f1515);color:white;text-decoration:none}.item-visual span{display:grid;width:3rem;aspect-ratio:1;place-items:center;border:1px dashed rgba(255,255,255,.7);background:rgba(255,255,255,.92);color:var(--color-ink);font-family:var(--font-display);font-weight:800}.item-main{display:flex;flex-direction:column;justify-content:space-between;gap:1.2rem}.item-kicker{margin:0;color:var(--color-brand);font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.item-main h3{margin:.2rem 0}.item-main h3 a{text-decoration:none}.item-options{display:grid;gap:.2rem;color:var(--color-ink-soft);font-size:.78rem}.item-controls{display:flex;align-items:end;gap:1rem}.item-controls label{display:grid;gap:.25rem;color:var(--color-ink-soft);font-size:.7rem}.quantity-input{width:5rem!important;min-height:2.5rem!important}.remove-button{padding:.4rem;border:0;background:transparent;color:var(--color-danger);cursor:pointer;font-size:.78rem;font-weight:800;text-decoration:underline}.item-price{display:grid;align-content:start;justify-items:end;gap:.2rem}.item-price span{color:var(--color-ink-faint);font-size:.72rem}.summary-card{position:sticky;top:7rem;padding:1.5rem;border:1px solid var(--color-ink);border-radius:var(--radius-md);background:var(--color-surface);box-shadow:var(--shadow-2)}.summary-card h2{font-family:var(--font-body);font-size:1.25rem;letter-spacing:0}.summary-card dl{display:grid;gap:.9rem;margin-block:1.5rem}.summary-card dl>div{display:flex;justify-content:space-between;gap:1rem;color:var(--color-ink-soft);font-size:.88rem}.summary-card dd{margin:0;color:var(--color-ink);font-weight:700}.summary-card .summary-total{padding-top:1rem;border-top:1px solid var(--color-border);color:var(--color-ink);font-size:1.1rem;font-weight:800}.summary-trust{display:grid;gap:.45rem;margin-top:1.2rem;color:var(--color-ink-soft);font-size:.73rem}.cart-validation{display:grid;gap:.2rem;margin-top:1rem;padding:1rem;border-left:3px solid var(--color-warning);background:var(--color-warning-soft);color:var(--color-warning);font-size:.82rem}@media(max-width:52rem){.cart-heading,.cart-layout{grid-template-columns:1fr;gap:1rem}.summary-card{position:relative;top:auto}}@media(max-width:36rem){.cart-item{grid-template-columns:5rem 1fr}.item-visual{min-height:6rem}.item-price{grid-column:2;justify-items:start}.item-controls{align-items:start;flex-direction:column}}
</style>
