---
import CatalogLayout from '../layouts/CatalogLayout.astro';
const apiBaseUrl=(import.meta.env.PUBLIC_API_BASE_URL??'http://127.0.0.1:8000/api').replace(/\/+$/,'');
---
<CatalogLayout title="Track Your Order" description="Check production and delivery progress for an Okina Craft order." noindex>
  <div class="container tracking-page" data-tracking data-api-base={apiBaseUrl}><div class="tracking-intro"><p class="eyebrow">Order progress</p><h1>Track what happens next.</h1><p class="lede">Enter your order number. For privacy, you’ll need to be signed into the account that placed it.</p></div><form class="tracking-form" data-tracking-form><label class="field"><span class="field-label">Order number</span><input name="order_id" required placeholder="For example: ORD-…" autocomplete="off"/></label><button class="button button--brand" type="submit">Track order</button></form><div class="tracking-result hidden" data-tracking-result aria-live="polite"></div></div>
  <script>
  const root=document.querySelector('[data-tracking]');if(root){const form=root.querySelector('[data-tracking-form]');const result=root.querySelector('[data-tracking-result]');const escapeHtml=(value)=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));form?.addEventListener('submit',async(event)=>{event.preventDefault();const id=new FormData(form).get('order_id')?.toString().trim();if(!id)return;result.className='tracking-result';result.innerHTML='<div class="spinner"></div><span>Finding your order…</span>';try{const response=await fetch(`${root.dataset.apiBase}/customer/orders/${encodeURIComponent(id)}`,{credentials:'include',headers:{Accept:'application/json'}});if(response.status===401||response.status===403){const login=root.dataset.apiBase.replace(/\/api$/,'/login');result.innerHTML=`<h2>Sign in to track this order</h2><p>Your order information is private.</p><a class="button button--brand" href="${login}">Sign in</a>`;return}if(response.status===404){result.innerHTML='<h2>Order not found</h2><p>Check the number and make sure you are using the account that placed it.</p>';return}if(!response.ok)throw new Error();const order=(await response.json()).data;const timeline=Array.isArray(order.timeline)?order.timeline:[];result.innerHTML=`<div class="result-head"><div><span>Order</span><h2>${escapeHtml(order.public_id)}</h2></div><span class="badge badge--success">${escapeHtml(String(order.status??'received').replaceAll('_',' '))}</span></div><ol class="timeline">${timeline.map(item=>`<li class="${item.completed?'is-complete':''}"><span></span><div><strong>${escapeHtml(item.label??item.status)}</strong>${item.timestamp?`<small>${new Intl.DateTimeFormat('en-IN',{dateStyle:'medium'}).format(new Date(item.timestamp))}</small>`:''}</div></li>`).join('')}</ol><a class="text-link" href="/account/orders/${encodeURIComponent(order.public_id)}">View full order details →</a>`}catch{result.innerHTML='<h2>Tracking is temporarily unavailable</h2><p>Please try again in a moment.</p>'}})}
  </script>
</CatalogLayout>
<style>.tracking-page{max-width:62rem;padding-block:clamp(4rem,10vw,8rem)}.tracking-intro h1{max-width:10ch}.tracking-form{display:grid;grid-template-columns:1fr auto;gap:.8rem;max-width:44rem;margin-block:3rem}.tracking-form .button{align-self:end}.tracking-result{display:grid;gap:1rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface)}.tracking-result>.spinner{width:1.6rem;height:1.6rem}.result-head{display:flex;align-items:center;justify-content:space-between;gap:1rem}.result-head span:first-child{color:var(--color-ink-faint);font-size:.7rem;text-transform:uppercase}.result-head h2{margin:0;font-family:var(--font-body);font-size:1.2rem;letter-spacing:0}.timeline{display:grid;gap:0;padding:1rem 0;margin:0;list-style:none}.timeline li{display:grid;grid-template-columns:1.5rem 1fr;gap:.7rem;min-height:3.5rem;color:var(--color-ink-faint)}.timeline li>span{position:relative;width:.75rem;height:.75rem;margin-top:.3rem;border:2px solid var(--color-border-strong);border-radius:50%}.timeline li:not(:last-child)>span::after{position:absolute;top:.7rem;left:50%;width:1px;height:2.8rem;background:var(--color-border);content:""}.timeline li.is-complete{color:var(--color-ink)}.timeline li.is-complete>span{border-color:var(--color-success);background:var(--color-success)}.timeline li div{display:grid}.timeline small{color:var(--color-ink-faint)}@media(max-width:34rem){.tracking-form{grid-template-columns:1fr}}</style>
