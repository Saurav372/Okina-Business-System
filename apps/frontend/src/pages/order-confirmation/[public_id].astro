---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
const {public_id}=Astro.params;
const apiBaseUrl=(import.meta.env.PUBLIC_API_BASE_URL??'http://127.0.0.1:8000/api').replace(/\/+$/,'');
---
<CatalogLayout title="Order Received" description="Your Okina Craft order has been received." noindex>
  <div class="container confirmation" data-confirmation data-api-base={apiBaseUrl} data-order-id={public_id}>
    <div class="success-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg></div><p class="eyebrow">Order received</p><h1>Thank you. We’ve got it.</h1><p class="lede">Your choices, artwork, and delivery details are now connected to order <strong>{public_id}</strong>.</p>
    <div class="next-steps"><article><span>01</span><h2>Payment check</h2><p>We confirm the payment provider response and attach it to your order.</p></article><article><span>02</span><h2>Artwork review</h2><p>Our team checks artwork and placement before anything enters production.</p></article><article><span>03</span><h2>Progress updates</h2><p>Production and shipping milestones will appear in your account.</p></article></div>
    <div class="confirmation-status" data-order-status><div class="spinner" aria-hidden="true"></div><span>Loading the latest order status…</span></div><div class="cluster confirmation-actions"><a class="button button--brand" href={`/account/orders/${public_id}`}>View order details</a><a class="button button--ghost" href="/categories">Keep browsing</a></div>
  </div>
  <script>
    const root=document.querySelector('[data-confirmation]');if(root){const status=root.querySelector('[data-order-status]');fetch(`${root.dataset.apiBase}/customer/orders/${encodeURIComponent(root.dataset.orderId)}`,{credentials:'include',headers:{Accept:'application/json'}}).then(async response=>{if(!response.ok)throw new Error();const order=(await response.json()).data;status.innerHTML=`<span class="status-dot"></span><span>Order status: <strong>${String(order.status??'received').replaceAll('_',' ')}</strong> · Payment: <strong>${String(order.payment_status??'pending').replaceAll('_',' ')}</strong></span>`}).catch(()=>{status.innerHTML='<span>The order is saved. Sign in to view its latest status.</span>'})}
  </script>
</CatalogLayout>
<style>.confirmation{max-width:68rem;padding-block:clamp(4rem,10vw,8rem);text-align:center}.success-mark{display:grid;width:4.5rem;aspect-ratio:1;margin:0 auto 1.5rem;place-items:center;border-radius:50%;background:var(--color-success-soft);color:var(--color-success)}.success-mark svg{width:2.2rem}.confirmation h1{max-width:12ch;margin-inline:auto}.confirmation>.lede{margin-inline:auto}.next-steps{display:grid;grid-template-columns:repeat(3,1fr);margin-block:4rem;border-block:1px solid var(--color-border);text-align:left}.next-steps article{padding:2rem;border-right:1px solid var(--color-border)}.next-steps article:last-child{border:0}.next-steps span{color:var(--color-brand);font-family:var(--font-display)}.next-steps h2{margin:1.4rem 0 .5rem;font-family:var(--font-body);font-size:1rem;letter-spacing:0}.next-steps p{margin:0;color:var(--color-ink-soft);font-size:.82rem}.confirmation-status{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:3rem;padding:1rem;border-radius:var(--radius-sm);background:var(--color-surface);font-size:.85rem}.confirmation-status .spinner{width:1.2rem;height:1.2rem;border-width:2px}.status-dot{width:.6rem;height:.6rem;border-radius:50%;background:var(--color-success)}.confirmation-actions{justify-content:center;margin-top:1.5rem}@media(max-width:42rem){.next-steps{grid-template-columns:1fr}.next-steps article{border-right:0;border-bottom:1px solid var(--color-border)}}</style>
