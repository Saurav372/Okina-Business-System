---
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductVisual from '../components/ProductVisual.astro';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { defaultStorefrontConfig, getCatalogHomeData, getStorefrontConfig, type CatalogCategory, type CatalogProduct } from '../lib/catalog';

let categories: CatalogCategory[] = [];
let products: CatalogProduct[] = [];
let catalogAvailable = true;
try { ({ categories, products } = await getCatalogHomeData()); } catch { catalogAvailable = false; }
let storefrontConfig = defaultStorefrontConfig;
try { storefrontConfig = await getStorefrontConfig(); } catch { /* The page keeps its safe branding fallback. */ }
const featuredCategories = categories.slice(0, 4);
const featuredProducts = products.slice(0, 8);
const heroProduct = products[0];
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).toString();
const organizationContact = [storefrontConfig.business.support_email && { '@type': 'ContactPoint', email: storefrontConfig.business.support_email, contactType: 'customer support' }, storefrontConfig.business.support_phone && { '@type': 'ContactPoint', telephone: storefrontConfig.business.support_phone, contactType: 'customer support' }].filter(Boolean);
const organizationSchema = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: storefrontConfig.business.company_name, url: siteUrl, description: storefrontConfig.seo.meta_description ?? 'Custom apparel for teams, events, businesses, and creators.', contactPoint: organizationContact },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: storefrontConfig.seo.site_title, url: siteUrl, potentialAction: { '@type': 'SearchAction', target: `${siteUrl}search?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
];
---

<CatalogLayout title="Custom Apparel, Made Personal" description="Create custom apparel for teams, events, businesses, and ideas. Clear pricing, artwork review, and careful production." structuredData={organizationSchema}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Custom apparel · made in India</p>
        <h1><span>Wear the idea.</span><span class="hero-title-accent">Make it yours.</span></h1>
        <p class="lede">Choose the garment, place your artwork, and approve the proof before anything is printed.</p>
        <div class="cluster hero-actions"><a class="button button--brand" href="#featured">Shop custom apparel <span aria-hidden="true">→</span></a><a class="button button--ghost" href="/mockup-generate">Create a mockup</a></div>
        <dl class="hero-proof" aria-label="Order benefits"><div><dt>01</dt><dd><strong>Proof first</strong><span>Approve before production</span></dd></div><div><dt>02</dt><dd><strong>One or one hundred</strong><span>Personal and bulk orders</span></dd></div><div><dt>03</dt><dd><strong>Track every step</strong><span>From artwork to delivery</span></dd></div></dl>
      </div>
      <div class="hero-stage">
        <span class="stage-index">Campaign / 01</span>
        <ProductVisual name={heroProduct?.name ?? 'Okina Original'} image={heroProduct?.cover_image} tone="red" priority />
        <a class="stage-product" href={heroProduct ? `/products/${heroProduct.slug}` : '/categories'}><span>Featured canvas</span><strong>{heroProduct?.name ?? 'Okina Original'}</strong><span aria-hidden="true">↗</span></a>
        <span class="stage-stamp" aria-hidden="true">OKINA<br/>CRAFT</span>
      </div>
    </div>
  </section>

  <section class="use-strip" aria-label="Popular reasons to order"><div class="use-strip-track"><span>Team uniforms</span><b aria-hidden="true">✦</b><span>College events</span><b aria-hidden="true">✦</b><span>Company merchandise</span><b aria-hidden="true">✦</b><span>Creator drops</span><b aria-hidden="true">✦</b><span>Personal gifts</span></div></section>

  {featuredCategories.length > 0 && <section class="container section-space purpose-section"><div class="section-head purpose-head"><div><p class="eyebrow">Shop by purpose</p><h2>Start with who it’s for.</h2></div><p class="lede">The right garment depends on the room, the team, and how it needs to work. Choose the closest starting point.</p></div><div class="category-grid">{featuredCategories.map((category, index) => <CategoryCard category={category} index={index} />)}</div></section>}

  <section class="featured-products section-rule" id="featured"><div class="container section-space">
    <div class="section-head"><div><p class="eyebrow">Popular canvases</p><h2>Ready for your mark.</h2></div><a class="button button--ghost" href="/search">View every product <span aria-hidden="true">→</span></a></div>
    {catalogAvailable && featuredProducts.length > 0 ? <div class="product-grid">{featuredProducts.map((product, index) => <ProductCard product={product} index={index} />)}</div> : catalogAvailable ? <div class="panel empty-state"><h3>Fresh styles are on the way</h3><p class="muted">We’re preparing the first collection. Please check back soon.</p></div> : <div class="panel empty-state"><h3>Our catalog is taking a short pause</h3><p class="muted">The products could not be loaded just now. Refresh the page in a moment.</p><button class="button button--ghost" onclick="window.location.reload()">Try again</button></div>}
  </div></section>

  <section class="process section-rule" id="how-it-works"><div class="container section-space"><div class="process-intro"><p class="eyebrow">From file to fabric</p><h2>Know what happens before it happens.</h2><p class="lede">Every choice stays attached to the order. We check the artwork, you approve the proof, then production begins.</p></div><ol class="process-list"><li><span>01</span><div><strong>Choose the canvas</strong><p>Style, colour, size and quantity.</p></div></li><li><span>02</span><div><strong>Place the artwork</strong><p>Upload the file and choose its position.</p></div></li><li><span>03</span><div><strong>Approve the proof</strong><p>See the setup before we make it.</p></div></li><li><span>04</span><div><strong>Print and check</strong><p>Production starts after approval.</p></div></li><li><span>05</span><div><strong>Track delivery</strong><p>Follow the order from your account.</p></div></li></ol></div></section>

  <section class="container section-space"><div class="promise"><div><span class="promise-mark" aria-hidden="true">✓</span><p class="eyebrow">The Okina promise</p><h2>No surprise printing.</h2></div><div class="promise-copy"><p>Your artwork, garment, placement, quantity and approval remain together from checkout through production.</p><ul><li>Artwork stored securely</li><li>Proof approved by you</li><li>Order progress retained</li></ul><a class="button button--ghost promise-button" href="/how-it-works">See the complete process</a></div></div></section>
</CatalogLayout>

<style>
  .home-hero{padding-block:clamp(1rem,3vw,2.5rem) clamp(2.5rem,6vw,5rem);overflow:hidden}.hero-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(32rem,1.18fr);gap:clamp(1.5rem,4vw,4rem);align-items:stretch}.hero-copy{display:flex;min-height:clamp(38rem,67vw,48rem);flex-direction:column;justify-content:center;padding-block:2rem}.hero-copy h1{display:grid;max-width:10ch;margin-bottom:1.5rem;font-size:clamp(4rem,8vw,8.5rem)}.hero-title-accent{color:var(--color-brand);font-style:italic}.hero-actions{margin-block:1.5rem 2.5rem}.hero-proof{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:1.25rem 0 0;margin:auto 0 0;border-top:1px solid var(--color-ink);font-size:.74rem}.hero-proof div{display:grid;grid-template-columns:auto 1fr;gap:.65rem;padding-right:1rem}.hero-proof dt{color:var(--color-brand);font-weight:850}.hero-proof dd{display:grid;margin:0}.hero-proof span{color:var(--color-ink-faint)}.hero-stage{position:relative;min-width:0;overflow:hidden;border:1px solid var(--color-ink);background:#ded4c4}.hero-stage :global(.product-visual){height:100%;min-height:clamp(38rem,67vw,48rem)}.stage-index{position:absolute;z-index:3;top:1rem;left:1rem;padding:.45rem .6rem;background:var(--color-surface);font-size:.65rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.stage-product{position:absolute;z-index:3;right:1rem;bottom:1rem;display:grid;grid-template-columns:1fr auto;min-width:min(20rem,calc(100% - 2rem));padding:.8rem 1rem;background:var(--color-surface-strong);color:white;text-decoration:none}.stage-product>span:first-child{grid-column:1/-1;color:#bdb5ab;font-size:.62rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.stage-product strong{font-family:var(--font-display);font-size:1.1rem}.stage-stamp{position:absolute;z-index:2;right:1rem;top:1rem;color:var(--color-brand);font-family:var(--font-display);font-size:1.5rem;font-weight:800;line-height:.8;text-align:right;transform:rotate(3deg)}.use-strip{overflow:hidden;border-block:1px solid var(--color-ink);background:var(--color-brand);color:white}.use-strip-track{display:flex;width:max-content;min-width:100%;justify-content:space-around;gap:2rem;padding:.9rem 2rem;font-size:.7rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.use-strip-track span{white-space:nowrap}.use-strip-track b{color:#171513}.purpose-head{align-items:start}.purpose-head .lede{max-width:34rem}.featured-products{background:var(--color-surface)}.process{background:#dfd6c8}.process-intro{display:grid;grid-template-columns:.8fr 1.2fr;column-gap:4rem;align-items:end}.process-intro .eyebrow{grid-column:1/-1}.process-list{display:grid;grid-template-columns:repeat(5,1fr);padding:0;margin:3.5rem 0 0;border-top:1px solid var(--color-ink);list-style:none}.process-list li{display:grid;gap:3.5rem;padding:1rem 1rem 0 0;border-right:1px solid var(--color-border-strong)}.process-list li:last-child{border-right:0}.process-list li>span{color:var(--color-brand);font-size:.7rem;font-weight:850}.process-list strong{font-size:.88rem}.process-list p{margin:.35rem 0 0;color:var(--color-ink-soft);font-size:.78rem}.promise{position:relative;display:grid;grid-template-columns:.9fr 1fr;gap:4rem;padding:clamp(2rem,5vw,5rem);overflow:hidden;background:var(--color-surface-strong);color:white}.promise-mark{position:absolute;right:-.03em;bottom:-.35em;color:#302c29;font-family:var(--font-display);font-size:20rem;line-height:1}.promise>div{position:relative;z-index:1}.promise .eyebrow{color:#ff756e}.promise h2{max-width:8ch;margin:0}.promise-copy>p{max-width:34rem;color:#d0c8bf;font-size:1.15rem}.promise-copy ul{display:grid;gap:.65rem;padding:1.5rem 0;margin:1.5rem 0;border-block:1px solid #3c3834;list-style:none}.promise-copy li::before{margin-right:.6rem;color:#77c997;content:'✓'}.promise-button{border-color:#fff;color:#fff}
  @media(max-width:64rem){.hero-grid{grid-template-columns:1fr}.hero-copy{min-height:auto;padding-block:3rem}.hero-copy h1{font-size:clamp(4rem,12vw,7rem)}.hero-stage{max-height:44rem}.process-list{grid-template-columns:1fr}.process-list li{grid-template-columns:2rem 1fr;gap:1rem;padding:1rem 0;border-right:0;border-bottom:1px solid var(--color-border-strong)}}
  @media(max-width:48rem){.hero-proof,.process-intro,.promise{grid-template-columns:1fr}.hero-proof{gap:1rem}.hero-stage{order:-1;max-height:none}.hero-stage :global(.product-visual){min-height:28rem}.process-intro{align-items:start}.promise{gap:2rem}.purpose-head{gap:1rem}.use-strip-track{justify-content:flex-start}.process-list{margin-top:2.5rem}}
  @media(max-width:34rem){.hero-copy h1{font-size:3.65rem}.hero-proof{grid-template-columns:1fr}.hero-actions{align-items:stretch}.hero-actions .button{width:100%}.stage-stamp{display:none}}
</style>
<style>
  .hero-copy h1{max-width:11ch;font-size:clamp(3.75rem,6.25vw,6.75rem)}
  @media(max-width:64rem){.hero-copy h1{font-size:clamp(3.4rem,9vw,5.75rem)}}
  @media(max-width:34rem){.hero-copy h1{font-size:3.15rem}}
</style>
