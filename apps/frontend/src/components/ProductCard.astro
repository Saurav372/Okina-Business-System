---
import type { CatalogProduct } from '../lib/catalog';
import { formatMoney } from '../lib/catalog';
import ProductVisual from './ProductVisual.astro';

const { product, index = 0 } = Astro.props as { product: CatalogProduct; index?: number };
const tones = ['red', 'ink', 'sage', 'blue'] as const;
const availableSkus = product.skus.filter((sku) => sku.availability.available_for_checkout);
const startingPrice = product.skus.length ? Math.min(...product.skus.map((sku) => sku.price_minor)) : product.base_price_minor;
const categoryKeywords: Record<string, string> = {
  'custom-t-shirts': 'college event company merchandise creator merch personal gift bulk t-shirt printing',
  'team-layers': 'team uniform staff uniform college event hoodie sweatshirt',
  workwear: 'corporate uniform staff uniform company merchandise polo shirt',
  'event-kits': 'college event team group',
};
const searchText = [
  product.name,
  product.category?.name,
  product.short_description,
  product.description,
  product.bulk_threshold_quantity ? 'bulk pricing bulk order' : '',
  categoryKeywords[product.category?.slug ?? ''] ?? '',
].filter(Boolean).join(' ').toLowerCase();
---

<article class="product-card" data-product-card data-name={product.name.toLowerCase()} data-category={(product.category?.name ?? '').toLowerCase()} data-search={searchText} data-price={startingPrice}>
  <a class="visual-link" href={`/products/${product.slug}`} aria-label={`View ${product.name}`} data-analytics-event="select_item" data-analytics-label={product.slug}>
    <ProductVisual name={product.name} tone={tones[index % tones.length]} image={product.cover_image} compact />
    {product.bulk_threshold_quantity && <span class="product-flag">Bulk pricing</span>}
    <span class="visual-action" aria-hidden="true">Customize ↗</span>
  </a>
  <div class="product-card-body">
    <div class="product-card-title"><h3><a href={`/products/${product.slug}`}>{product.name}</a></h3><span>From <strong>{formatMoney(startingPrice, product.currency)}</strong></span></div>
    <div class="cluster product-meta"><span>{product.category?.name ?? 'Custom apparel'}</span><span aria-hidden="true">·</span><span>{availableSkus.length ? 'Ready to customize' : 'Enquire to order'}</span></div>
    <p>{product.short_description ?? 'Made to carry your idea, identity, or team mark.'}</p>
  </div>
</article>

<style>
  .product-card { min-width:0; }
  .visual-link { position:relative; display:block; overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius-md); background:var(--color-surface); text-decoration:none; }
  .product-flag { position:absolute; z-index:2; top:.65rem; left:.65rem; padding:.35rem .5rem; background:var(--color-surface-strong); color:white; font-size:.62rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  .visual-action{position:absolute;right:.65rem;bottom:.65rem;padding:.45rem .6rem;background:var(--color-surface-strong);color:white;font-size:.65rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase;opacity:0;transform:translateY(.35rem);transition:opacity var(--duration-fast),transform var(--duration-fast) var(--ease-out)}
  .visual-link:hover .visual-action,.visual-link:focus-visible .visual-action{opacity:1;transform:none}
  .product-card-body { padding:.85rem .1rem 0; }
  .product-card-title{display:flex;align-items:start;justify-content:space-between;gap:.75rem}.product-card-title>span{flex:0 0 auto;padding-top:.15rem;font-size:.78rem}.product-card-title strong{font-weight:850}
  .product-meta { margin-top:.45rem;color:var(--color-ink-faint); font-size:.65rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
  h3 { margin:0; font-family:var(--font-body);font-size:.96rem;letter-spacing:0;line-height:1.25; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--color-brand); }
  p { display:-webkit-box;min-height:2.6em;margin:.55rem 0 0;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:var(--color-ink-soft);font-size:.78rem; }
  @media(max-width:34rem){.visual-action{opacity:1;transform:none}.product-card-title{gap:.5rem}}
</style>
