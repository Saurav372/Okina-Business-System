---
import type { CatalogCategory } from '../lib/catalog';
const { category, index = 0 } = Astro.props as { category: CatalogCategory; index?: number };
const marks = ['01', '02', '03', '04', '05', '06'];
---

<a class:list={['category-card', `category-card--${index % 4}`]} href={`/categories/${category.slug}`}>
  <span class="category-top"><span class="category-index" aria-hidden="true">{marks[index % marks.length]}</span><span class="category-count">{category.products_count} {category.products_count === 1 ? 'style' : 'styles'}</span></span>
  <span class="category-art" aria-hidden="true"><span>{category.name.slice(0, 2).toUpperCase()}</span></span>
  <span class="category-copy"><strong>{category.name}</strong><span>{category.description ?? 'Custom pieces prepared for your group, event, or brand.'}</span></span>
  <span class="category-action">Shop the collection <span aria-hidden="true">↗</span></span>
</a>

<style>
  .category-card { --tile:#d9d0c0; --tile-ink:#171513; position:relative; display:grid; min-height:25rem; padding:1.25rem; overflow:hidden; grid-template-rows:auto 1fr auto auto; gap:1rem; border:1px solid var(--color-ink); border-radius:var(--radius-md); background:var(--tile); color:var(--tile-ink); text-decoration:none; transition:transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base); }
  .category-card--1{--tile:#1d2927;--tile-ink:#f7f1e7}.category-card--2{--tile:#c52b2b;--tile-ink:#fff}.category-card--3{--tile:#cec3af;--tile-ink:#171513}
  .category-card:hover{z-index:1;box-shadow:var(--shadow-2);transform:translateY(-4px)}
  .category-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-size:.67rem;font-weight:850;letter-spacing:.11em;text-transform:uppercase}
  .category-index{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid currentColor;border-radius:50%;font-family:var(--font-body)}
  .category-art{display:grid;place-items:center;align-self:center;justify-self:end;width:min(54%,15rem);aspect-ratio:1;border:1px solid currentColor;border-radius:50%;opacity:.9;transition:transform 500ms var(--ease-out)}
  .category-art span{display:grid;width:62%;aspect-ratio:1;place-items:center;border:1px dashed currentColor;border-radius:50%;font-family:var(--font-display);font-size:clamp(2.7rem,6vw,5rem);line-height:1}
  .category-card:hover .category-art{transform:rotate(7deg) scale(1.04)}
  .category-copy{display:grid;gap:.55rem;max-width:31rem}.category-copy strong{font-family:var(--font-display);font-size:clamp(2rem,4vw,3.6rem);font-weight:600;letter-spacing:-.04em;line-height:.95}.category-copy>span{max-width:34rem;font-size:.84rem;opacity:.78}
  .category-action{display:flex;align-items:center;justify-content:space-between;padding-top:.8rem;border-top:1px solid currentColor;font-size:.72rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  @media(max-width:48rem){.category-card{min-height:22rem}.category-art{width:10rem}.category-copy strong{font-size:2.5rem}}
</style>
