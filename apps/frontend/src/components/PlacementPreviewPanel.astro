---
const { productSlug, productName } = Astro.props as {
  productSlug: string;
  productName: string;
};

const apiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL ?? 'http://127.0.0.1:8000/api').replace(/\/+$/, '');
const previewEndpointBase = `${apiBaseUrl}/catalog/products/${productSlug}/design-preview`;
---

<section class="section placement-panel" data-placement-panel data-preview-endpoint-base={previewEndpointBase}>
  <div class="section-head">
    <div>
      <h2>Placement controls</h2>
      <p class="summary">Adjust the uploaded design within the print area and refresh the mockup preview.</p>
    </div>
    <span class="pill">Signed preview refresh</span>
  </div>

  <div class="placement-layout">
    <div class="panel placement-controls">
      <form class="stack" data-placement-form>
        <label class="field">
          <span class="field-label">Signed preview URL or file ID</span>
          <input
            type="text"
            name="preview_source"
            data-preview-source
            placeholder="Paste the signed preview URL from the upload step"
            autocomplete="off"
            spellcheck="false"
          />
        </label>

        <input type="hidden" name="print_position" value="front" data-print-position />
        <input type="hidden" name="print_method" value="dtf" data-print-method />

        <div class="placement-grid">
          <label class="field">
            <span class="field-label">Horizontal</span>
            <input type="range" name="placement[x]" min="0" max="100" step="1" value="50" data-placement-input="x" />
            <output data-placement-output="x">50</output>
          </label>

          <label class="field">
            <span class="field-label">Vertical</span>
            <input type="range" name="placement[y]" min="0" max="100" step="1" value="50" data-placement-input="y" />
            <output data-placement-output="y">50</output>
          </label>

          <label class="field">
            <span class="field-label">Scale</span>
            <input type="range" name="placement[scale]" min="0.35" max="1.5" step="0.01" value="1" data-placement-input="scale" />
            <output data-placement-output="scale">1.00</output>
          </label>

          <label class="field">
            <span class="field-label">Rotation</span>
            <input type="range" name="placement[rotation]" min="-45" max="45" step="1" value="0" data-placement-input="rotation" />
            <output data-placement-output="rotation">0</output>
          </label>
        </div>

        <div class="meta-row">
          <span class="pill">Product: {productName}</span>
          <span class="pill">Print position: front</span>
          <span class="pill">Print method: dtf</span>
        </div>

        <p class="summary" data-placement-status>
          Paste the signed preview URL or file ID from the upload response to load the preview.
        </p>
      </form>
    </div>

    <div class="panel preview-shell">
      <iframe
        title={`${productName} placement preview`}
        name="mockup-preview-frame"
        data-preview-frame
        class="preview-frame"
        srcdoc='<!doctype html><html lang="en"><head><meta charset="utf-8"><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f8f6f1;color:#5f6b7a;font-family:Inter,ui-sans-serif,system-ui,sans-serif;text-align:center;padding:2rem}strong{display:block;color:#1f2937;font-size:1.1rem;margin-bottom:.5rem}</style></head><body><div><strong>Preview will appear here</strong><div>Paste the signed upload preview URL or file ID to begin adjusting placement.</div></div></body></html>'
      ></iframe>
    </div>
  </div>

  <script type="module">
    const panel = document.querySelector('[data-placement-panel]');

    if (panel) {
      const endpointBase = panel.getAttribute('data-preview-endpoint-base');
      const form = panel.querySelector('[data-placement-form]');
      const previewSourceInput = panel.querySelector('[data-preview-source]');
      const frame = panel.querySelector('[data-preview-frame]');
      const status = panel.querySelector('[data-placement-status]');
      const printPosition = panel.querySelector('[data-print-position]');
      const printMethod = panel.querySelector('[data-print-method]');
      const controls = ['x', 'y', 'scale', 'rotation'].reduce((acc, key) => {
        acc[key] = {
          input: panel.querySelector(`[data-placement-input="${key}"]`),
          output: panel.querySelector(`[data-placement-output="${key}"]`),
        };
        return acc;
      }, {});

      const placementDefaults = {
        x: 50,
        y: 50,
        scale: 1,
        rotation: 0,
      };

      const toPreviewFileId = (value) => {
        if (!value) {
          return '';
        }

        const trimmed = String(value).trim();

        if (!trimmed) {
          return '';
        }

        try {
          const url = new URL(trimmed, window.location.origin);
          const segments = url.pathname.split('/').filter(Boolean);
          const previewIndex = segments.indexOf('design-preview');

          if (previewIndex >= 0 && segments[previewIndex + 1]) {
            return segments[previewIndex + 1];
          }
        } catch {
          // Fall back to the raw value below.
        }

        return trimmed;
      };

      const setStatus = (message) => {
        if (status) {
          status.textContent = message;
        }
      };

      const updateOutputs = () => {
        Object.entries(controls).forEach(([key, { input, output }]) => {
          if (!input || !output) {
            return;
          }

          const value = Number(input.value);
          if (key === 'scale') {
            output.textContent = value.toFixed(2);
          } else {
            output.textContent = String(Math.round(value));
          }
        });
      };

      const buildEndpoint = (previewFileId) => {
        if (!endpointBase || !previewFileId) {
          return '';
        }

        return `${endpointBase}/${encodeURIComponent(previewFileId)}/link`;
      };

      const submitPreview = () => {
        const previewFileId = toPreviewFileId(previewSourceInput?.value ?? '');
        const action = buildEndpoint(previewFileId);

        if (!action || !form || !frame) {
          return;
        }

        form.action = action;
        form.target = frame.name;
        form.method = 'post';

        if (printPosition) {
          printPosition.value = 'front';
        }

        if (printMethod) {
          printMethod.value = 'dtf';
        }

        if (!previewFileId) {
          setStatus('Paste the signed preview URL or file ID from the upload response to load the preview.');
          return;
        }

        setStatus('Refreshing signed preview link for the current placement.');
        form.requestSubmit();
      };

      let debounce = null;
      const scheduleRefresh = () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(submitPreview, 120);
      };

      Object.entries(controls).forEach(([key, { input, output }]) => {
        if (!input || !output) {
          return;
        }

        input.addEventListener('input', () => {
          updateOutputs();
          if (previewSourceInput?.value.trim()) {
            scheduleRefresh();
          }
        });

        input.value = String(placementDefaults[key]);
      });

      updateOutputs();

      previewSourceInput?.addEventListener('input', () => {
        scheduleRefresh();
      });

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        submitPreview();
      });
    }
  </script>

  <style>
    .placement-panel {
      display: grid;
      gap: 1rem;
    }

    .placement-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.35fr);
      gap: 1rem;
      align-items: start;
    }

    .placement-controls,
    .preview-shell {
      min-height: 100%;
    }

    .placement-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field {
      display: grid;
      gap: 0.45rem;
    }

    .field-label {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
    }

    .field input[type='text'] {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 0.6rem;
      padding: 0.8rem 0.9rem;
      background: var(--surface);
      color: var(--text);
      font: inherit;
    }

    .field input[type='range'] {
      width: 100%;
      accent-color: var(--accent);
    }

    .field output {
      color: var(--muted);
      font-size: 0.9rem;
      text-align: right;
    }

    .preview-frame {
      display: block;
      width: 100%;
      min-height: 780px;
      border: 0;
      border-radius: var(--radius);
      background: #f8f6f1;
    }

    @media (max-width: 960px) {
      .placement-layout,
      .placement-grid {
        grid-template-columns: 1fr;
      }

      .preview-frame {
        min-height: 620px;
      }
    }
  </style>
</section>
